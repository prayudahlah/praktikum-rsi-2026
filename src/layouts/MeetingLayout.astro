---
import BaseLayout from './BaseLayout.astro';
import {ArrowLeft, ArrowRight} from '@lucide/astro';

interface Props {
    title: string;
    description?: string;
    hasToc?: boolean;
    showTitle?: boolean;
    prev?: { slug: string; title: string };
    next?: { slug: string; title: string };
}

const { title, description, hasToc = false, showTitle = false, prev, next } = Astro.props;
---

<BaseLayout title={title} description={description} hasToc={hasToc}>
    {showTitle && (
        <header class="max-w-[1400px] mx-auto px-6 lg:px-8 pt-20 lg:pt-28 mb-10 lg:mb-16">
            <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight leading-tight">
                {title}
            </h1>
            {description && (
                <p class="mt-3 max-w-2xl text-base md:text-lg text-foreground-secondary leading-relaxed">
                    {description}
                </p>
            )}
        </header>
    )}

    <!-- Scrollytelling Content -->
    <div class="text-base md:text-lg lg:text-xl leading-relaxed">
        <slot />
    </div>

    <!-- Navigation -->
    <nav class="my-25 pt-8 flex justify-center">
        <div class="flex justify-between w-[90%] text-base lg:text-lg">
            {prev ? (
            <a href={`/meetings/${prev.slug}`} class="flex items-center px-4 py-1 gap-2 hover:text-primary transition-colors">
                    <ArrowLeft class="w-5 h-5" />
                    <div class="flex flex-col items-start">
                        <span class="text-sm opacity-60">Sebelumnya</span>
                        <p class="font-medium">{prev.title}</p>
                    </div>
                </a>
            ) : <div />}
            {next ? (
                <a href={`/meetings/${next.slug}`} class="flex items-center px-4 py-1 gap-2 hover:text-primary transition-colors">
                    <div>
                        <span class="text-sm opacity-60">Selanjutnya</span>
                        <p class="font-medium">{next.title}</p>
                    </div>
                    <ArrowRight class="w-5 h-5" />
                </a>
            ) : <div />}
        </div>
    </nav>
</BaseLayout>
