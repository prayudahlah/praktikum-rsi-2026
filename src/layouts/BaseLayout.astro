---
import '../styles/global.css'
import { Sun, Moon, Menu, ChevronRight, Lock, ListOrdered } from '@lucide/astro';
import { meetings } from '../data/meetings';

interface Props {
  title: string;
  description?: string;
  hasToc?: boolean;
}

const { title, description, hasToc = false } = Astro.props;

const pageDescription = description || "Interactive learning website untuk praktikum Rekayasa Sistem Informasi FATISDA UNS";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const ogImage = "/diagrams/01/step1.webp";

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/webp" href="/favicon.webp">
    <title>{title} · Praktikum RSI</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Praktikum RSI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical.href} />}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script is:inline>
        document.documentElement.classList.add('js');
        const setTheme = () => {
            const darkModeStored = localStorage.getItem('darkMode');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            if (darkModeStored === 'true' || (!darkModeStored && prefersDark)) {
                document.documentElement.classList.add('dark');
            } else {
                document.documentElement.classList.remove('dark');
            }
        };
        setTheme();
    </script>
</head>
<body class={`relative bg-background text-foreground min-h-screen ${hasToc ? 'lg:pl-60' : ''}`}>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:rounded focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground focus:font-medium">Lewati ke konten</a>

    <!-- Fixed header -->
    <header class="fixed top-0 left-0 right-0 h-14 bg-surface-raised border-b border-border z-40 flex items-center px-4 gap-1">
        <div id="meetings-menu" class="relative">
            <button
                id="meetings-toggle"
                type="button"
                aria-label="Daftar pertemuan"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="meetings-panel"
                class="p-2 rounded hover:bg-hover transition-colors"
            >
                <Menu class="w-6 h-6" />
            </button>

            <div
                id="meetings-panel"
                class="hidden absolute left-0 top-full mt-2 w-72 max-w-[calc(100vw-2rem)] overflow-hidden rounded-xl border border-border bg-surface-raised shadow-xl z-50"
            >
                <nav aria-label="Daftar pertemuan" class="max-h-[70vh] overflow-y-auto py-1">
                    {meetings.map((meeting) => (
                    <a
                        href={`/meetings/${meeting.slug}`}
                        aria-current={currentPath === `/meetings/${meeting.slug}` ? 'page' : undefined}
                        class={`flex items-center gap-2 px-4 py-2 border-l-2 border-transparent transition-colors
                        ${meeting.published
                            ? 'hover:bg-hover'
                            : 'text-muted-foreground hover:bg-hover'
                        }
                        ${
                            currentPath === `/meetings/${meeting.slug}`
                            ? 'bg-primary/10 text-primary border-primary'
                            : ''
                        }`}
                    >
                        <span>{meeting.order}. {meeting.title}</span>
                        {!meeting.published && <Lock class="w-4 h-4 ml-auto shrink-0" />}
                        {meeting.published && currentPath === `/meetings/${meeting.slug}` && <ChevronRight class="w-4 h-4 ml-auto" />}
                    </a>
                    ))}
                </nav>
            </div>
        </div>

        <a href="/" class="flex items-center gap-2">
            <h2 class="text-lg sm:text-xl font-bold whitespace-nowrap">PRAKTIKUM RSI</h2>
        </a>

        <div class="ml-auto flex items-center gap-1">
            {hasToc && (
                <button
                    type="button"
                    id="toc-toggle"
                    data-toc-toggle
                    aria-label="Daftar isi"
                    aria-expanded="false"
                    aria-controls="toc-panel"
                    class="p-2 rounded hover:bg-hover transition-colors lg:hidden"
                >
                    <ListOrdered class="w-6 h-6" />
                </button>
            )}
            <button data-dark-mode-toggle aria-label="Toggle dark mode" class="p-2 rounded hover:bg-hover transition-colors">
                <Sun class="w-5 h-5 hidden dark:block" />
                <Moon class="w-5 h-5 block dark:hidden" />
            </button>
        </div>
    </header>


    <!-- Main Content -->
    <main id="main" tabindex="-1">
        <slot/>
    </main>

    <!-- Back to top -->
    <button
        id="back-to-top"
        type="button"
        aria-label="Kembali ke atas"
        class="fixed bottom-6 right-6 z-40 p-3 rounded-full border border-border bg-surface-raised text-muted-foreground shadow-lg opacity-0 pointer-events-none transition-opacity hover:bg-hover hover:text-foreground"
    >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 15-6-6-6 6" />
        </svg>
    </button>

    <!-- Footer -->
    <footer class="mt-16 py-12 px-8 border-t border-border">
        <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
            <div>
                <p class="font-medium">© 2026 Praktikum RSI</p>
                <p class="text-sm text-muted-foreground mt-1">Website pembelajaran untuk praktikum mata kuliah Rekayasa Sistem Informasi FATISDA UNS</p>
            </div>
            <div class="flex gap-4">
                <a href="https://github.com/prayudahlah/praktikum-rsi-2026" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors">
                    <img src="/icons/github.svg" alt="Github Logo" class="w-4 h-4 invert-0 dark:invert transition-all" loading="lazy"/>
                    <span>GitHub</span>
                </a>
            </div>
        </div>
    </footer>


    <!-- Scripts -->
    <script>
        // Dark Mode Toggle
        const html = document.documentElement;
        document.querySelectorAll('[data-dark-mode-toggle]').forEach((btn) => {
            btn.addEventListener('click', () => {
                html.classList.toggle('dark');
                localStorage.setItem('darkMode', html.classList.contains('dark').toString());
            });
        });

        // Meetings dropdown
        const meetingsMenu = document.getElementById('meetings-menu');
        const meetingsToggle = document.getElementById('meetings-toggle');
        const meetingsPanel = document.getElementById('meetings-panel');

        const setMeetingsOpen = (open: boolean) => {
            meetingsPanel?.classList.toggle('hidden', !open);
            meetingsToggle?.setAttribute('aria-expanded', String(open));
        };

        meetingsToggle?.addEventListener('click', (e) => {
            e.stopPropagation();
            setMeetingsOpen(meetingsPanel?.classList.contains('hidden') ?? false);
        });

        document.addEventListener('mousedown', (e) => {
            if (!meetingsMenu || meetingsPanel?.classList.contains('hidden')) return;
            if (meetingsMenu.contains(e.target as Node)) return;
            setMeetingsOpen(false);
        });

        document.addEventListener('keydown', (e) => {
            if (e.key !== 'Escape') return;
            if (meetingsPanel && !meetingsPanel.classList.contains('hidden')) {
                setMeetingsOpen(false);
                meetingsToggle?.focus();
            }
        });

        // Back to top
        const backToTop = document.getElementById('back-to-top');
        const toggleBackToTop = () => {
            if (!backToTop) return;
            const show = window.scrollY > 500;
            backToTop.classList.toggle('opacity-0', !show);
            backToTop.classList.toggle('pointer-events-none', !show);
        };
        backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        window.addEventListener('scroll', toggleBackToTop, { passive: true });
        toggleBackToTop();
    </script>
</body>
</html>
