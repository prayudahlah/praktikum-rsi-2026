---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';

import h1EnvBackend from '../snippets/09/h1-env-backend.txt?raw';
import h1EnvFrontend from '../snippets/09/h1-env-frontend.txt?raw';
import h1Transaction from '../snippets/09/h1-transaction.txt?raw';
import h1AuditService from '../snippets/09/h1-audit-service.txt?raw';
import h1AuditRoute from '../snippets/09/h1-audit-route.txt?raw';
import h1AuditPage from '../snippets/09/h1-audit-page.txt?raw';
import h1AuditHelper from '../snippets/09/h1-audit-helper.txt?raw';
import h1Types from '../snippets/09/h1-types.txt?raw';
import c1Checklist from '../snippets/09/c1-checklist.txt?raw';

const inlineCode = 'font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded';

const repoUrl = 'https://github.com/rrrambatsigma/praktikum-rsi-2026';
const featBranch = 'feat/pertemuan-9';
const starterBranch = 'starter/pertemuan-09';
const ho1Path = 'pertemuan-09-audit-log-system/hands-on-1-audit-log';
const ho1Url = `${repoUrl}/tree/${featBranch}/${ho1Path}`;

const cloneStarter = `git clone --single-branch --branch ${starterBranch} ${repoUrl}.git praktikum-pert-9`;

const runBackend = `cd praktikum-pert-9/${ho1Path}/backend
npm install
npm run dev`;

const runFrontend = `cd praktikum-pert-9/${ho1Path}/frontend
npm install
npm run dev`;

const folderTree = `praktikum-pert-9/
└─ pertemuan-09-audit-log-system/
   ├─ db/                              # skema, index, dan seed audit
   │  ├─ 01-audit-log-schema.sql
   │  ├─ 02-audit-seed.sql
   │  └─ 03-audit-samples.sql
   └─ hands-on-1-audit-log/
      ├─ backend/                      # Express + mssql, lengkap
      │  └─ src/ ...                    # transaksi, audit, endpoint
      └─ frontend/                     # React + Tailwind
         └─ src/pages/AuditLogPage.tsx  # TODO`;

const createTableSql = `CREATE TABLE dbo.AUDIT_LOGS (
    id           INT IDENTITY(1,1) NOT NULL
                 CONSTRAINT PK_AUDIT_LOGS PRIMARY KEY,
    user_id      INT NOT NULL,
    action       NVARCHAR(50) NOT NULL,
    target_table NVARCHAR(50) NOT NULL,
    target_id    INT NOT NULL,
    metadata     NVARCHAR(MAX) NULL,
    created_at   DATETIME2(0) NOT NULL
                 CONSTRAINT DF_AUDIT_LOGS_created_at
                 DEFAULT SYSUTCDATETIME(),
    CONSTRAINT FK_AUDIT_LOGS_USERS
        FOREIGN KEY (user_id) REFERENCES dbo.USERS (id)
);`;

const auditExample = `INSERT INTO dbo.AUDIT_LOGS
    (user_id, action, target_table, target_id, metadata)
VALUES
    (3, N'UPDATE_MENU', N'MENU_ITEMS', 7,
     N'{"before":{"name":"Es Teh"},"after":{"name":"Es Jeruk"}}');`;

const responseExample = `GET /api/audit-logs?action=UPDATE_MENU&page=1&pageSize=20
Cookie: kantin_session_ho2=...

HTTP/1.1 200 OK
Content-Type: application/json

{
  "status": "success",
  "data": {
    "items": [
      {
        "id": 21,
        "userId": 3,
        "userName": "Tini",
        "userEmail": "tini@kantin.test",
        "action": "UPDATE_MENU",
        "targetTable": "MENU_ITEMS",
        "targetId": 7,
        "metadata": { "before": {}, "after": {}, "changed": ["name"] },
        "createdAt": "2026-11-10T09:15:00.000Z"
      }
    ],
    "pagination": {
      "page": 1,
      "pageSize": 20,
      "total": 1,
      "totalPages": 1
    }
  }
}`;

const verificationSql = `USE review_kantin;
GO

SELECT TOP (20)
    a.id,
    a.created_at,
    u.email,
    a.action,
    a.target_table,
    a.target_id,
    a.metadata
FROM dbo.AUDIT_LOGS a
LEFT JOIN dbo.USERS u ON u.id = a.user_id
ORDER BY a.created_at DESC, a.id DESC;
GO`;

const tocSections: TOCSection[] = [
    {
        label: 'Dasar Audit Log',
        items: [
            { id: 's1', title: 'Kenapa Audit Log?' },
            { id: 's2', title: 'Audit Log vs Application Log' },
            { id: 's3', title: 'Prinsip dan Anatomi' },
            { id: 's4', title: 'Skema dan Index' },
        ],
    },
    {
        label: 'Mekanisme',
        items: [
            { id: 's5', title: 'Mutasi dan Audit Atomik' },
            { id: 's6', title: 'Endpoint Riwayat dan RBAC' },
            { id: 's7', title: 'Halaman Riwayat' },
        ],
    },
    {
        label: 'Hands-on 1: Audit Log',
        items: [
            { id: 'h1', title: 'Ambil Starter & Kenali TODO' },
            { id: 'h2', title: 'Halaman Riwayat Audit' },
            { id: 'h3', title: 'Uji Hands-on 9' },
        ],
    },
    {
        label: 'Penutup',
        items: [{ id: 'c1', title: 'Checklist & Rangkuman' }],
    },
];
---

<ScrollySection className="meeting-relaxed">
    <ScrollyLayout defaultSrc="/diagrams/09/hook.webp" placeholder>

        <Step id="s1" diagram="/diagrams/09/hook.webp">
            <SectionDivider label="Audit Log System" />
            <StepHeader title="Kenapa Audit Log?" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                Pada Pertemuan 8, owner bisa menambah, mengubah, dan menghapus menu, sedangkan
                admin bisa mengubah status pesanan. Begitu aplikasi dipakai, pertanyaan yang
                muncul biasanya adalah siapa yang mengubah data ini dan kapan. Karena itu, tiap
                aktivitas harus dicatat dan bisa ditelusuri dengan mudah.
            </p>

            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Audit log menjawab pertanyaan itu. Setiap aktivitas penting disimpan sebagai satu
                baris berisi <strong>pelaku</strong>, aksi,{' '}
                data yang disentuh, dan waktu kejadian. Audit log
                ini hanya mendukung penambahan (<strong>append-only</strong>), tidak diubah atau
                dihapus dari aplikasi, sehingga bisa dipakai saat ada masalah yang perlu
                ditelusuri.
            </p>

            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Log ini dipakai untuk:
            </p>
            <ul class="mt-2 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>Menelusuri <strong>perubahan data</strong> dan siapa yang melakukannya.</li>
                <li>Menyelidiki <strong>data hilang atau berubah</strong> tanpa izin.</li>
                <li>Mendeteksi <strong>akses mencurigakan</strong>.</li>
                <li>Membantu <strong>debug</strong> saat data berubah tanpa penjelasan.</li>
                <li>Memenuhi <strong>kebutuhan kepatuhan</strong> dan audit internal.</li>
            </ul>

            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Pegangan utama</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Kalau catatan audit masih bisa diubah atau dihapus dari aplikasi, catatan itu{' '}
                    <strong>tidak bisa dipakai sebagai bukti</strong>.
                </p>
            </div>
        </Step>

        <Step id="s2" diagram="/diagrams/09/app-log-vs-audit-log.webp">
            <StepHeader title="Audit Log vs Application Log" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                Keduanya catatan, tetapi tujuannya berbeda. Audit log menjawab{' '}
                <strong>siapa melakukan apa</strong>. Application log menjawab{' '}
                <strong>sistem sedang apa</strong>.
            </p>

            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Aspek</th>
                            <th class="px-3 py-2 font-semibold">Audit log</th>
                            <th class="px-3 py-2 font-semibold">Application log</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Tujuan</td>
                            <td class="px-3 py-2">Investigasi dan bukti</td>
                            <td class="px-3 py-2">Debug dan monitoring</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Isi</td>
                            <td class="px-3 py-2">Aktor, aksi, target, hasil</td>
                            <td class="px-3 py-2">Error, stack trace, durasi, performa</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Sifat</td>
                            <td class="px-3 py-2">Append-only, tidak diubah</td>
                            <td class="px-3 py-2">Boleh dirotasi dan dihapus</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Akses</td>
                            <td class="px-3 py-2">Admin dan auditor</td>
                            <td class="px-3 py-2">Developer dan operasional</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Retensi</td>
                            <td class="px-3 py-2">Lama, mengikuti kebijakan</td>
                            <td class="px-3 py-2">Pendek, biasanya harian</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Keduanya perlu, tetapi disimpan di tempat berbeda. Application log boleh
                dibersihkan kapan saja, sedangkan audit log tidak. Kalau digabung, pembersihan
                log lama bisa ikut menghapus bukti.
            </p>
        </Step>

        <Step id="s3" diagram="/diagrams/09/audit-log-example.webp">
            <StepHeader title="Prinsip dan Anatomi" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                Audit log yang berguna punya empat aturan dasar:
            </p>

            <ul class="mt-2 text-foreground-secondary leading-relaxed space-y-2 list-disc list-inside">
                <li>
                    <strong>Append-only.</strong> Hanya boleh ditambah. Tidak ada endpoint ubah
                    atau hapus dari aplikasi.
                </li>
                <li>
                    <strong>Terpusat.</strong> Ditulis di backend, tepatnya di service layer.
                    Frontend hanya mengirim permintaan, dan penulisan tidak tersebar di banyak
                    controller.
                </li>
                <li>
                    <strong>Cukup detail.</strong> Siapa, kapan, apa, target, dan hasilnya.
                    Jangan simpan password, token, atau cookie.
                </li>
                <li>
                    <strong>Cepat dibaca.</strong> Ada index, filter, pagination, dan tampilan
                    yang jelas. Audit yang sulit dibaca sama saja tidak ada.
                </li>
            </ul>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Anatomi satu baris audit</h4>
            <div class="mt-3 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Field</th>
                            <th class="px-3 py-2 font-semibold">Arti</th>
                            <th class="px-3 py-2 font-semibold">Contoh</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>user_id</code></td>
                            <td class="px-3 py-2">Pelaku aksi</td>
                            <td class="px-3 py-2 font-mono">3</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>action</code></td>
                            <td class="px-3 py-2">Nama aksi</td>
                            <td class="px-3 py-2 font-mono">UPDATE_MENU</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>target_table</code></td>
                            <td class="px-3 py-2">Tabel yang disentuh</td>
                            <td class="px-3 py-2 font-mono">MENU_ITEMS</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>target_id</code></td>
                            <td class="px-3 py-2">Primary key objek</td>
                            <td class="px-3 py-2 font-mono">7</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>metadata</code></td>
                            <td class="px-3 py-2">Konteks tambahan, JSON</td>
                            <td class="px-3 py-2 font-mono">before, after, changed</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>created_at</code></td>
                            <td class="px-3 py-2">Waktu kejadian, UTC</td>
                            <td class="px-3 py-2 font-mono">2026-11-10 09:15:00</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <CodeBlock
                code={auditExample}
                language="sql"
                filename="Contoh isi satu baris audit"
                compact
            />

            <div class="mt-4 p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Jangan simpan data sensitif</span>
                <p class="mt-1 text-sm md:text-base text-foreground-secondary leading-relaxed">
                    Metadata tidak boleh memuat <strong>password</strong>, hash password,{' '}
                    <strong>token JWT</strong>, <strong>cookie</strong>, atau header otorisasi. Tulis hanya data yang memang perlu untuk menjelaskan
                    perubahan.
                </p>
            </div>
        </Step>

        <Step id="s4">
            <StepHeader title="Skema dan Index" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                Tabel audit sudah dibuat pada <strong>Pertemuan 3</strong>, tepatnya di skema{' '}
                <code class={inlineCode}>review_kantin</code>. Kolomnya sedikit. Yang menentukan
                adalah apakah catatannya <strong>bisa dipercaya</strong>.
            </p>

            <CodeBlock
                code={createTableSql}
                language="sql"
                filename="dbo.AUDIT_LOGS"
            />

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Kenapa perlu tiga index</h4>
            <ul class="text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>
                    <code class={inlineCode}>created_at DESC, id DESC</code>: halaman riwayat
                    selalu menampilkan yang terbaru lebih dulu.
                </li>
                <li>
                    <code class={inlineCode}>user_id, created_at DESC</code>: saat menyelidiki
                    aktivitas satu pengguna.
                </li>
                <li>
                    <code class={inlineCode}>action, target_table, created_at</code>: saat
                    memfilter aksi tertentu pada target tertentu.
                </li>
            </ul>

            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Index tidak mengubah hasil query, hanya cara database mencarinya. Tanpa index,
                query riwayat <strong>memindai seluruh tabel</strong>. Dengan data praktikum mungkin tidak terasa,
                tetapi kebiasaan ini penting saat data bertambah.
            </p>

            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Soal waktu</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Kolom <code class={inlineCode}>created_at</code> memakai{' '}
                    <code class={inlineCode}>SYSUTCDATETIME()</code>, jadi waktu disimpan dalam
                    UTC. Frontend menampilkannya dalam zona waktu browser. Cara ini membuat data
                    tetap benar walaupun server dan laptop berada di zona waktu berbeda.
                </p>
            </div>
        </Step>

        <Step id="s5">
            <StepHeader title="Mutasi dan Audit Atomik" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                Menulis audit relatif mudah. Yang perlu dijaga adalah agar audit dan mutasi
                bisnis tidak terpisah. Kalau menu berhasil disimpan tetapi audit gagal, jejaknya
                hilang. Kalau audit berhasil tetapi menu gagal, catatan menggambarkan hal yang
                tidak pernah terjadi. Keduanya sama-sama salah.
            </p>

            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Solusinya <strong>satu transaksi</strong>. Mutasi dan insert audit memakai objek transaksi
                yang sama, lalu <strong>di-commit bersama</strong> atau <strong>di-rollback bersama</strong>.
            </p>

            <CodeBlock
                code={h1Transaction}
                language="ts"
                filename="backend/src/db/transaction.ts"
            />

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Service audit</h4>
            <p class="text-foreground-secondary leading-relaxed">
                Semua penulisan audit melewati satu service. Mutasi memakai{' '}
                <code class={inlineCode}>record()</code> dengan transaksi. Login memakai{' '}
                <code class={inlineCode}>recordLogin()</code> yang menangkap error sendiri.
            </p>

            <CodeBlock
                code={h1AuditService}
                language="ts"
                filename="backend/src/services/auditLogService.ts"
            />

            <ul class="mt-3 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>
                    <strong>Audit wajib</strong> untuk create, update, delete menu, checkout, dan
                    perubahan status pesanan. Gagal audit berarti mutasi dibatalkan.
                </li>
                <li>
                    <strong>Audit best-effort</strong> untuk login. Gagal menulis audit tidak
                    boleh mengunci pengguna, tetapi error tetap dicatat di log server.
                </li>
                <li>
                    Snapshot <code class={inlineCode}>before</code> diambil dari kondisi data
                    sebelum diubah, supaya perubahan bisa dipertanggungjawabkan.
                </li>
            </ul>
        </Step>

        <Step id="s6">
            <StepHeader title="Endpoint Riwayat dan RBAC" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                Riwayat audit bukan data publik. Hanya <strong>admin</strong> yang boleh membacanya, dan{' '}
                <strong>backend</strong> yang harus memastikan itu. Menyembunyikan menu di frontend tidak cukup, karena
                endpoint tetap bisa dipanggil langsung.
            </p>

            <CodeBlock
                code={h1AuditRoute}
                language="ts"
                filename="backend/src/routes/auditLogRouter.ts"
            />

            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Method</th>
                            <th class="px-3 py-2 font-semibold">Path</th>
                            <th class="px-3 py-2 font-semibold">Akses</th>
                            <th class="px-3 py-2 font-semibold">Fungsi</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">GET</td>
                            <td class="px-3 py-2 font-mono">/api/audit-logs</td>
                            <td class="px-3 py-2">Admin</td>
                            <td class="px-3 py-2">Riwayat dengan filter dan pagination</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">POST</td>
                            <td class="px-3 py-2 font-mono">/api/menu</td>
                            <td class="px-3 py-2">Owner</td>
                            <td class="px-3 py-2">Tambah menu, lalu menulis audit</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">PATCH</td>
                            <td class="px-3 py-2 font-mono">/api/orders/:id/status</td>
                            <td class="px-3 py-2">Admin</td>
                            <td class="px-3 py-2">Ubah status pesanan, lalu menulis audit</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Parameter query</h4>
            <div class="mt-3 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Parameter</th>
                            <th class="px-3 py-2 font-semibold">Nilai</th>
                            <th class="px-3 py-2 font-semibold">Keterangan</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>page</code></td>
                            <td class="px-3 py-2">integer, minimal 1</td>
                            <td class="px-3 py-2">Halaman yang diminta</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>pageSize</code></td>
                            <td class="px-3 py-2">1 sampai 100</td>
                            <td class="px-3 py-2">Jumlah baris per halaman</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>action</code></td>
                            <td class="px-3 py-2">teks, maksimal 50</td>
                            <td class="px-3 py-2">Cocok persis, misalnya LOGIN</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>targetTable</code></td>
                            <td class="px-3 py-2">teks, maksimal 50</td>
                            <td class="px-3 py-2">Misalnya MENU_ITEMS</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>from</code></td>
                            <td class="px-3 py-2">YYYY-MM-DD</td>
                            <td class="px-3 py-2">Awal hari, inklusif</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2"><code class={inlineCode}>to</code></td>
                            <td class="px-3 py-2">YYYY-MM-DD</td>
                            <td class="px-3 py-2">Akhir hari, inklusif</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <CodeBlock
                code={responseExample}
                language="http"
                filename="Contoh respons"
            />

