---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import { BookOpen } from '@lucide/astro';
import expressHealth from '../snippets/02/express-health.ts?raw';
import packageJson from '../snippets/02/package-json.json?raw';
import tsconfig from '../snippets/02/tsconfig.json?raw';
import stallRepository from '../snippets/02/stall-repository.ts?raw';
import stallDto from '../snippets/02/stall-dto.ts?raw';
import stallService from '../snippets/02/stall-service.ts?raw';
import stallController from '../snippets/02/stall-controller.ts?raw';
import stallRouter from '../snippets/02/stall-router.ts?raw';
import stallIndex from '../snippets/02/stall-index.ts?raw';

const tocSections: TOCSection[] = [
    {
        label: 'REST API',
        items: [
            { id: 'p1-1', title: 'Apa itu Backend?' },
            { id: 'p1-2', title: 'Kenapa Backend Wajib?' },
            { id: 'p1-3', title: 'REST API & HTTP Methods' },
            { id: 'p1-4', title: 'Endpoint & URL' },
            { id: 'p1-5', title: 'Kirim Data dari Client' },
            { id: 'p1-6', title: 'Format JSON' },
            { id: 'p1-7', title: 'Status Code' },
        ]
    },
    {
        label: 'Hands-on 1',
        items: [
            { id: 'h1-1', title: 'Setup Project' },
            { id: 'h1-2', title: 'Menjalankan TS (tsx)' },
            { id: 'h1-3', title: 'Endpoint /health' },
            { id: 'h1-4', title: 'Menjalankan Server' },
        ]
    },
    {
        label: 'Arsitektur Layered',
        items: [
            { id: 'p4-1', title: 'Mengapa Butuh Layer?' },
            { id: 'p4-2', title: 'Layered Architecture' },
        ]
    },
    {
        label: 'Hands-on 2',
        items: [
            { id: 'h2-1', title: 'Repository' },
            { id: 'h2-2', title: 'DTO' },
            { id: 'h2-3', title: 'Service' },
            { id: 'h2-4', title: 'Controller' },
            { id: 'h2-5', title: 'Router' },
            { id: 'h2-6', title: 'Integrasi Entry Point' },
            { id: 'h2-7', title: 'Uji Endpoint' },
        ]
    },
];

const strukturHandsOn1 = `my-api/
├─ package.json
├─ tsconfig.json
└─ src/
   └─ index.ts`;

const strukturHandsOn2 = `my-api/
├─ package.json
├─ tsconfig.json
└─ src/
   ├─ index.ts                # diubah: daftarkan router
   ├─ routes/
   │  └─ stallRouter.ts       # baru
   ├─ controllers/
   │  └─ stallController.ts   # baru
   ├─ services/
   │  └─ stallService.ts      # baru
   ├─ repositories/
   │  └─ stallRepository.ts   # baru
   └─ dtos/
      └─ stallDto.ts          # baru`;
---

<ScrollySection>
    <ScrollyLayout defaultSrc="/diagrams/02/step1.webp">

        <Step id="p1-1" diagram="/diagrams/02/step1.webp">
            <SectionDivider label="REST API" />
            <StepHeader title="Apa itu Backend?" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                <strong class="text-success">Backend</strong> adalah bagian server yang bertanggung jawab atas
                logika bisnis, validasi, pengolahan data, dan <strong>komunikasi dengan Database</strong>.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Client tidak langsung mengakses database. Semua permintaan melewati backend
                yang menjadi <strong>perantara</strong> antara frontend dan data.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
            Bayangkan aplikasi adalah sebuah restoran. Frontend adalah meja tempat pelanggan
            melihat menu dan memesan. <strong>Backend adalah Koki di Dapur</strong>.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Pelanggan (Client) tidak diizinkan masuk ke Gudang Makanan (Database) untuk mengambil bahan sendiri. Mereka harus meminta ke Koki. Koki inilah yang bertugas mengecek pesanan, mengambil bahan di gudang, memasaknya (logika bisnis), dan menyajikannya kembali ke pelanggan.
            </p>
        </Step>

        <Step id="p1-2" diagram="/diagrams/02/step1.webp">
            <StepHeader title="Kenapa Backend Wajib?" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                Bayangkan frontend langsung terhubung ke database tanpa backend di tengah.
                Tiga masalah fatal muncul:
            </p>
            <div class="mt-4 space-y-3">
                <div class="p-3 rounded-lg bg-error/5 dark:bg-error/10 border-l-4 border-error">
                    <span class="font-bold text-error">Kebocoran Keamanan</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Kredensial database dan query rahasia ikut terunduh di kode frontend publik,
                        siapa pun bisa mengintip isi database atau menghapus tabel.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                    <span class="font-bold text-warning">Tanpa Validasi</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Data bisa dimanipulasi sebelum disimpan, misalnya mengubah harga
                        barang dari Rp100.000 menjadi Rp-10.000 tanpa pengecekan ulang.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-accent/5 dark:bg-accent/10 border-l-4 border-accent">
                    <span class="font-bold text-accent">Kacau saat Ramai</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Database tidak didesain melayani ribuan akses bersamaan. Backend menjadi
                        <strong> traffic controller</strong> yang mengamankan dan mengatur antrean.
                    </p>
                </div>
            </div>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Karena itu backend <strong>wajib</strong> berdiri di antara frontend dan data.
            </p>
        </Step>

        <Step id="p1-3" diagram="/diagrams/02/step3.webp">
            <StepHeader title="Apa itu REST API dan HTTP Methods?" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                REST adalah <strong>arsitektur</strong> yang mengatur bagaimana frontend
                dan backend saling berkomunikasi. Di dalam arsitektur REST ini, HTTP Methods
                digunakan sebagai <strong>standar protokol</strong> untuk menentukan aksi apa yang ingin dilakukan terhadap data.  
            </p>
            <div class="mt-4 space-y-1">
                <div class="p-3 rounded-lg bg-success/5 dark:bg-success/10 border-l-4 border-success">
                    <span class="font-bold text-success">POST (Create)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Membuat atau menambahkan data baru ke server, misalnya saat mendaftarkan akun baru.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                    <span class="font-bold text-primary">GET (Read)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Mengambil atau melihat data dari server, misalnya menampilkan daftar produk.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                    <span class="font-bold text-warning">PUT / PATCH (Update)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Mengubah data yang sudah ada. <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">PUT</code> mengganti seluruh
                        bagian, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">PATCH</code> hanya sebagian.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-error/5 dark:bg-error/10 border-l-4 border-error">
                    <span class="font-bold text-error">DELETE (Delete)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Menghapus data yang ada di server.
                    </p>
                </div>
            </div>
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://restfulapi.net/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                            REST API Tutorial (RESTful API Design)
                        </a>
                        : penjelasan komprehensif konsep REST dari dasar hingga best practice.
                    </li>
                    <li>
                        <a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Methods" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                            MDN Web Docs: Request methods
                        </a>
                        : dokumentasi resmi ramah pemula, detail tiap HTTP method beserta contohnya.
                    </li>
                </ul>
            </div>
        </Step>

        <Step id="p1-4" diagram="/diagrams/02/step4.webp">
            <StepHeader title="Endpoint & URL" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Jika HTTP Method bertindak sebagai <strong>kata kerja</strong> (apa yang ingin dilakukan:
                mengambil, membuat, menghapus), maka <strong>Endpoint & URL</strong> bertindak sebagai
                <strong> alamat / objek tujuan</strong> dari data tersebut.
            </p>
            <div class="mt-4 space-y-3">
                <div class="p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                    <span class="font-bold text-primary">Alamat Spesifik Objek/Resource</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        URL menunjuk data mana yang dituju, dengan nama resource jamak:
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">/api/v1/users</code>
                        untuk kumpulan pengguna, atau
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">/api/v1/users/5</code>
                        untuk satu pengguna dengan ID 5.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-accent/5 dark:bg-accent/10 border-l-4 border-accent">
                    <span class="font-bold text-accent">Keamanan Versi (Versioning)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Awalan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">/api/v1/</code>
                        ditambahkan agar saat backend diperbarui besar-besaran, aplikasi client lama
                        tidak langsung rusak atau error.
                    </p>
                </div>
            </div>
            <div class="mt-4 p-3 rounded-lg bg-success/5 dark:bg-success/10 border-l-4 border-success">
                <span class="font-bold text-success">HTTP Method + Endpoint</span>
                <p class="text-sm md:text-base text-muted-foreground mt-1">
                    Walaupun URL <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">/api/v1/users/5</code>
                    dipakai oleh <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">GET</code>
                    maupun <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">DELETE</code>,
                    hasilnya sangat berbeda. <em>GET</em> mengambil data user, <em>DELETE</em> menghapusnya secara permanen.
                </p>
            </div>
        </Step>

        <Step id="p1-5" diagram="/diagrams/02/step4.webp">
            <StepHeader title="Cara Kirim Data dari Client" tone="accent" />
            <p class="text-foreground-secondary leading-relaxed">
                Setelah menentukan alamat URL dan metode HTTP, bagaimana cara client
                <strong> membungkus data</strong> yang ingin dikirim ke server? Data dikirim
                melalui tiga bagian utama pada Request:
            </p>
            <div class="mt-4 space-y-2">
                <div class="p-3 rounded-lg bg-accent/5 dark:bg-accent/10 border-l-4 border-accent">
                    <span class="font-bold text-accent">Path Parameter</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Bagian yang melekat langsung pada URL untuk menunjuk identitas data spesifik, misalnya
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">/users/5</code>,
                        angka <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">5</code> adalah ID unik milik user.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                    <span class="font-bold text-primary">Query Parameter</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Bagian tambahan di akhir URL menggunakan tanda tanya (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">?</code>),
                        untuk filter, pencarian, atau pembagian halaman (<em>pagination</em>), misalnya
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">/products?category=food&amp;page=2</code>.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-success/5 dark:bg-success/10 border-l-4 border-success">
                    <span class="font-bold text-success">Request Body</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Ruang khusus untuk mengirim data yang lebih kompleks atau berukuran besar dalam format JSON,
                        paling sering dipakai saat mendaftarkan akun baru menggunakan metode POST.
                    </p>
                </div>
            </div>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Masing-masing bagian memiliki fungsi spesifik dan digunakan secara bergantian
                tergantung skenario aksi yang ingin dilakukan oleh client.
            </p>

            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://github.com/saifaustcse/rest-api-best-practices" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                            GitHub: REST API Best Practices &amp; Naming Conventions
                        </a>
                        : dokumentasi ringkas tentang cara menyusun path parameter, query string,
                        dan hierarki endpoint yang bersih sesuai standar industri.
                    </li>
                </ul>
            </div>
        </Step>


        <Step id="p1-6" diagram="/diagrams/02/step5.webp">
            <StepHeader title="Server Menjawab Dengan Format JSON" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                Setelah backend selesai memproses request, saatnya backend memberikan
                <strong> Response</strong>. Agar bisa dipahami platform apa pun, data dibungkus dengan format universal yaitu <strong>JSON </strong>
                 (<em>JavaScript Object Notation</em>).
            </p>
             <div class="mt-4 p-4 rounded-lg bg-surface-overlay font-mono text-sm leading-relaxed whitespace-pre">
                 <div class="text-zinc-400">{`{`}</div>
                 <div>  <span class="text-violet-400">"success"</span>: <span class="text-amber-400">true</span>,</div>
                 <div>  <span class="text-violet-400">"message"</span>: <span class="text-amber-400">"Data pengguna berhasil diambil"</span>,</div>
                 <div>  <span class="text-violet-400">"data"</span>: <span class="text-zinc-400">{`{`}</span></div>
                 <div>    <span class="text-violet-400">"id"</span>: <span class="text-amber-400">5</span>,</div>
                 <div>    <span class="text-violet-400">"name"</span>: <span class="text-amber-400">"Prayuda Afifan"</span>,</div>
                 <div>    <span class="text-violet-400">"role"</span>: <span class="text-amber-400">"customer"</span>,</div>
                 <div>    <span class="text-violet-400">"email"</span>: <span class="text-amber-400">"prayuda@example.com"</span></div>
                 <div>  <span class="text-zinc-400">{`}`}</span></div>
                 <div class="text-zinc-400">{`}`}</div>
            </div>
        </Step>

        <Step id="p1-7" diagram="/diagrams/02/step6.webp">
            <StepHeader title="Membaca Jawaban Server: HTTP Status Code" tone="warning" />
            <p class="text-foreground-secondary leading-relaxed">
                Bersamaan dengan data JSON, server selalu menyelipkan <strong>HTTP Status Code</strong>.
                Fungsinya untuk memberi tahu client secara instan apakah permintaan berhasil, ditolak, atau gagal total,
                tanpa harus membaca seluruh isi JSON terlebih dahulu.
            </p>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Berikut contoh yang <strong class="text-warning">paling sering muncul</strong>:
            </p>
            <div class="mt-4 space-y-2">
                <div class="p-3 rounded-lg bg-success/5 dark:bg-success/10 border-l-4 border-success">
                    <span class="font-bold text-success">2xx (Berhasil)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        Permintaan diproses tanpa masalah. Contoh:
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">200 OK</code>
                        sukses umum (misal berhasil mengambil data produk),
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">201 Created</code>
                        saat akun berhasil didaftarkan di database.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                    <span class="font-bold text-warning">4xx (Kesalahan Client)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        "Aku nggak bisa proses ini karena client yang salah kirim." Contoh:
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">400</code> input salah format,
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">401</code> belum login akses data rahasia,
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">404</code> endpoint/data tidak ada.
                    </p>
                </div>
                <div class="p-3 rounded-lg bg-error/5 dark:bg-error/10 border-l-4 border-error">
                    <span class="font-bold text-error">5xx (Kesalahan Server)</span>
                    <p class="text-sm md:text-base text-muted-foreground mt-1">
                        "Permintaanmu benar, tapi sistem kami (backend) yang sedang rusak." Contoh:
                        <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">500 Internal Server Error</code>
                        ada bug/crash di backend atau database sedang mati.
                    </p>
                </div>
            </div>
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://developer.mozilla.org/en-US/docs/Web/HTTP/Status" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                            MDN Web Docs: HTTP response status codes
                        </a>
                        : referensi resmi arti mendetail setiap status code.
                    </li>
                    <li>
                        <a href="https://http.cat/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">HTTP Cats </a>
                        atau
                        <a href="https://httpstatusdogs.com/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline"> HTTP Dogs</a>
                        : visualisasi tiap status code dengan meme kucing/anjing.
                    </li>
                </ul>
            </div>
        </Step>


        <!-- ===== SECTION 3.5: HANDS-ON 1 ===== -->

        <Step id="h1-1" diagram="/diagrams/02/step8.webp">
            <SectionDivider label="Hands-on 1" />
            <StepHeader title="Setup Project & Instalasi Express" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                Sebelum menulis kode backend, kita perlu membuat folder khusus dan
                menyiapkan proyek <strong>Node.js</strong> terlebih dahulu.
            </p>
            <a href="https://github.com/rrrambatsigma/praktikum-rsi-2026/tree/main/pertemuan-02-backend-rest-api-crud"
               target="_blank" rel="noopener noreferrer"
               class="my-3 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline">
                <img src="/icons/github.svg" alt="" aria-hidden="true" class="w-4 h-4 invert-0 dark:invert" />
                Kode Hands-on di GitHub
            </a>
            <TerminalBlock code={`mkdir my-api && cd my-api # Buat folder my-api dan pergi ke sana\nmkdir src # Folder khusus kode sumber\nnpm init -y\nnpm install express\nnpm install -D typescript tsx @types/express @types/node\nnpx tsc --init`} title="Terminal: Setup project" />
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Setelah setup selesai, struktur folder proyek kita:
            </p>
            <CodeBlock code={strukturHandsOn1} language="bash" />
            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Apa itu package.json?</span>
                <p class="text-sm md:text-base text-muted-foreground mt-1">
                    File <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">package.json</code>
                    bertindak sebagai "identitas" proyek yang mencatat seluruh pustaka
                    (<em>dependencies</em>) yang kita pakai. Ia dibuat otomatis oleh perintah
                    <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">npm init -y</code>,
                    dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">npm install express</code>
                    menyimpan Express ke dalamnya.
                </p>
            </div>

