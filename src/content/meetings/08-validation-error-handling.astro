---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';
import { BookOpen } from '@lucide/astro';

import s6ErrorContract from '../snippets/08/s6-error-contract.txt?raw';

import h1EnvBackend from '../snippets/08/h1-env-backend.txt?raw';
import h1EnvFrontend from '../snippets/08/h1-env-frontend.txt?raw';
import h1Validation from '../snippets/08/h1-validation.txt?raw';
import h1ApiData from '../snippets/08/h1-api-data.txt?raw';
import h1ApiAuth from '../snippets/08/h1-api-auth.txt?raw';
import h1MenuSchema from '../snippets/08/h1-menu-schema.txt?raw';
import h1AuthSchema from '../snippets/08/h1-auth-schema.txt?raw';

import h2EnvBackend from '../snippets/08/h2-env-backend.txt?raw';
import h2EnvFrontend from '../snippets/08/h2-env-frontend.txt?raw';
import h2Errors from '../snippets/08/h2-errors.txt?raw';
import h2Http from '../snippets/08/h2-http.txt?raw';
import h2ApiMenu from '../snippets/08/h2-api-menu.txt?raw';
import h2ApiRegister from '../snippets/08/h2-api-register.txt?raw';
import h2ApiOrder from '../snippets/08/h2-api-order.txt?raw';
import h2ApiOrderStatus from '../snippets/08/h2-api-order-status.txt?raw';
import h2ValidationRegister from '../snippets/08/h2-validation-register.txt?raw';
import h2ValidationCheckout from '../snippets/08/h2-validation-checkout.txt?raw';
import h2ProtectedRoute from '../snippets/08/h2-protected-route.txt?raw';
import h2Authorize from '../snippets/08/h2-authorize.txt?raw';
import h2Ownership from '../snippets/08/h2-ownership.txt?raw';
import h2ErrorHandler from '../snippets/08/h2-error-handler.txt?raw';

import c1Checklist from '../snippets/08/c1-checklist.txt?raw';

const inlineCode = 'font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded';

const repoUrl = 'https://github.com/rrrambatsigma/praktikum-rsi-2026';
const featBranch = 'feat/pertemuan-08-validasi-error-handling';
const starterBranch = 'starter/pertemuan-08';
const ho1Path = 'pertemuan-08-validasi-error-handling/hands-on-1-form-validation';
const ho2Path = 'pertemuan-08-validasi-error-handling/hands-on-2-centralized-error-handling';
const ho1Url = `${repoUrl}/tree/${featBranch}/${ho1Path}`;
const ho2Url = `${repoUrl}/tree/${featBranch}/${ho2Path}`;
const starterUrl = `${repoUrl}/tree/${starterBranch}/pertemuan-08-validasi-error-handling`;

const ghFile = (path: string, branch = featBranch) => `${repoUrl}/blob/${branch}/${path}`;
const ho1File = (file: string) => ghFile(`${ho1Path}/${file}`);
const ho2File = (file: string) => ghFile(`${ho2Path}/${file}`);

const cloneStarter = `git clone --single-branch --branch ${starterBranch} ${repoUrl}.git praktikum-pert-8`;

const runHo1Backend = `cd praktikum-pert-8/${ho1Path}/backend
npm install
npm run dev`;

const runHo1Frontend = `cd praktikum-pert-8/${ho1Path}/frontend
npm install
npm run dev`;

const runHo2Backend = `cd praktikum-pert-8/${ho2Path}/backend
npm install
npm run dev`;

const runHo2Frontend = `cd praktikum-pert-8/${ho2Path}/frontend
npm install
npm run dev`;

const folderTree = `praktikum-pert-8/
└─ pertemuan-08-validasi-error-handling/
   ├─ db/                              # migrasi + seed
   ├─ hands-on-1-form-validation/
   │  ├─ backend/                      # Express + zod + mssql
   │  │  └─ src/ ...                    # sudah lengkap
   │  └─ frontend/                     # React + Fetch API
   │     └─ src/lib/validation.ts      # TODO
   │     └─ src/lib/api.ts             # TODO
   └─ hands-on-2-centralized-error-handling/
      ├─ backend/                      # Express + RBAC + Axios contract
      │  └─ src/ ...                    # sudah lengkap
      └─ frontend/                     # React + Axios
         └─ src/lib/errors.ts          # TODO
         └─ src/lib/http.ts            # TODO
         └─ src/lib/api.ts             # TODO
         └─ src/lib/validation.ts      # TODO
         └─ src/components/ProtectedRoute.tsx  # TODO`;

const httpExample = `POST /api/menu
Content-Type: application/json

{
  "stallId": 1,
  "name": "Es Jeruk",
  "category": "minuman",
  "price": -5000
}

HTTP/1.1 400 Bad Request
Content-Type: application/json
X-Request-Id: 8b7f0f5e-4e86-4f4e-9a77-6b1f5a9f0c11

{
  "status": "fail",
  "code": "VALIDATION_ERROR",
  "message": "Data yang dikirim tidak valid.",
  "errors": [
    { "field": "price", "message": "Harga harus lebih dari 0." }
  ],
  "requestId": "8b7f0f5e-4e86-4f4e-9a77-6b1f5a9f0c11"
}`;

const tocSections: TOCSection[] = [
    {
        label: 'Dasar Validasi',
        items: [
            { id: 's1', title: 'Mengapa Validasi & Error Handling?' },
            { id: 's2', title: 'Validation: Frontend vs Backend' },
            { id: 's3', title: 'Frontend Form Validation' },
            { id: 's4', title: 'API Error & HTTP Status Code' },
        ],
    },
    {
        label: 'Error Handling',
        items: [
            { id: 's5', title: 'Error Handling di Frontend' },
            { id: 's6', title: 'Konsistensi Error Response' },
            { id: 's7', title: 'Protected Route & Access Control' },
        ],
    },
    {
        label: 'Hands-on 1: Form & Fetch',
        items: [
            { id: 'h1', title: 'Ambil Starter & Kenali TODO' },
            { id: 'h2', title: 'Validasi Form (validation.ts)' },
            { id: 'h3', title: 'Fetch API (api.ts)' },
            { id: 'h4', title: 'Backend Memvalidasi Ulang' },
            { id: 'h5', title: 'Uji Hands-on 1' },
        ],
    },
    {
        label: 'Hands-on 2: Error Terpusat & RBAC',
        items: [
            { id: 'b1', title: 'Starter, Env, dan Akun Demo' },
            { id: 'b2', title: 'errors.ts dan http.ts' },
            { id: 'b3', title: 'API Axios (api.ts)' },
            { id: 'b4', title: 'Validasi Register & Checkout' },
            { id: 'b5', title: 'Protected Route & RBAC' },
            { id: 'b6', title: 'Uji Hands-on 2' },
        ],
    },
    {
        label: 'Penutup',
        items: [{ id: 'c1', title: 'Checklist & Rangkuman' }],
    },
];
---

<ScrollySection className="meeting-relaxed">
    <ScrollyLayout defaultSrc="/diagrams/08/slide-1.webp">

        <!-- ===== SLIDE 1 ===== -->

        <Step id="s1" diagram="/diagrams/08/slide-1.webp">
            <SectionDivider label="Validasi & Error Handling" />
            <StepHeader title="Mengapa Validasi & Error Handling?" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                <strong>Validasi</strong> dan <strong>error handling</strong> merupakan bagian penting dalam
                pengembangan aplikasi. Validasi memastikan data yang diproses sesuai aturan, sedangkan error
                handling memastikan aplikasi dapat merespons kegagalan secara tepat. Keduanya bekerja di titik
                yang berbeda, tetapi tujuannya sama: menjaga aplikasi tetap dapat dipercaya.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Tanpa validasi, data kosong, salah format, atau nilai yang tidak masuk akal bisa masuk ke
                database. Tanpa error handling, satu kegagalan kecil dapat membuat pengguna melihat layar
                kosong, pesan teknis yang membingungkan, atau aplikasi yang seolah berhenti bekerja.
            </p>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Mengapa keduanya diperlukan?</h4>
            <ul class="text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li><strong>Menjaga kualitas data:</strong> mencegah data kosong, salah format, atau tidak sesuai aturan masuk ke proses aplikasi.</li>
                <li><strong>Meningkatkan pengalaman pengguna:</strong> memberikan pesan yang jelas ketika input tidak valid atau proses gagal.</li>
                <li><strong>Menjaga keamanan aplikasi:</strong> memastikan data dan tindakan pengguna diperiksa sesuai aturan dan hak akses.</li>
                <li><strong>Menjaga konsistensi sistem:</strong> memastikan kesalahan ditangani secara terstruktur di berbagai bagian aplikasi.</li>
                <li><strong>Mempermudah pemeliharaan:</strong> membantu pengembang mengidentifikasi dan menangani sumber kesalahan.</li>
            </ul>

            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Aspek</th>
                            <th class="px-3 py-2 font-semibold">Validasi</th>
                            <th class="px-3 py-2 font-semibold">Error Handling</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Fokus</td>
                            <td class="px-3 py-2">Memastikan data memenuhi aturan sebelum diproses</td>
                            <td class="px-3 py-2">Menjaga aplikasi tetap terkendali ketika terjadi kegagalan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Waktu bekerja</td>
                            <td class="px-3 py-2">Sebelum data digunakan atau disimpan</td>
                            <td class="px-3 py-2">Saat proses berjalan, gagal, atau menerima respons yang tidak diharapkan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Contoh di kantin</td>
                            <td class="px-3 py-2">Menolak harga <code class={inlineCode}>-5000</code></td>
                            <td class="px-3 py-2">Menampilkan “Menu gagal disimpan. Silakan coba lagi.”</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Studi kasus: harga menu -5000</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Pengguna mengisi harga menu sebesar <code class={inlineCode}>-5000</code> pada aplikasi
                    kantin kampus. Tanpa validasi, nilai itu berpotensi diproses sebagai harga menu. Dengan
                    validasi, aplikasi menolak input dan menampilkan pesan{' '}
                    <strong>“Harga harus lebih dari 0.”</strong>
                </p>
                <p class="mt-2 text-sm md:text-base text-foreground-secondary">
                    Jika proses penyimpanan gagal karena server bermasalah, error handling menampilkan pesan
                    seperti <strong>“Menu gagal disimpan. Silakan coba lagi.”</strong> Pengguna tetap tahu apa
                    yang terjadi dan dapat mencoba kembali.
                </p>
            </div>

            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Dengan kata lain, validasi adalah penjaga pintu masuk data, sedangkan error handling adalah
                prosedur ketika sesuatu tetap gagal di tengah jalan. Keduanya harus dirancang bersama, bukan
                ditambahkan belakangan setelah aplikasi selesai.
            </p>

            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://developer.mozilla.org/en-US/docs/Learn_web_development/Extensions/Forms/Form_validation" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">MDN: Client-side form validation</a>
                        : dasar validasi form dan pesan kesalahan.
                    </li>
                    <li>
                        <a href="https://cheatsheetseries.owasp.org/cheatsheets/Input_Validation_Cheat_Sheet.html" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">OWASP: Input Validation Cheat Sheet</a>
                        : praktik validasi input dari sisi keamanan.
                    </li>
                </ul>
            </div>
        </Step>

        <!-- ===== SLIDE 2 ===== -->

        <Step id="s2" diagram="/diagrams/08/slide-2.webp">
            <StepHeader title="Validation: Frontend vs Backend" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                <strong>Validasi</strong> adalah proses pemeriksaan data untuk memastikan bahwa input memenuhi
                aturan yang ditetapkan sebelum digunakan atau diproses oleh sistem. Validasi dapat dilakukan
                pada dua lapisan, yaitu frontend dan backend, yang memiliki peran berbeda tetapi saling
                melengkapi.
            </p>

            <h4 class="mt-4 font-semibold text-foreground">1. Frontend Validation</h4>
            <p class="mt-2 text-foreground-secondary leading-relaxed">
                Validasi yang dilakukan pada sisi pengguna (client-side), biasanya melalui browser sebelum data
                dikirim ke server.
            </p>
            <ul class="mt-2 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>Memberikan umpan balik secara langsung kepada pengguna.</li>
                <li>Memeriksa kelengkapan input, format, tipe, dan rentang nilai.</li>
                <li>Mengurangi pengiriman request dengan input yang jelas tidak valid.</li>
                <li>Contoh: memastikan kolom nama tidak kosong dan format email sesuai.</li>
            </ul>

            <h4 class="mt-4 font-semibold text-foreground">2. Backend Validation</h4>
            <p class="mt-2 text-foreground-secondary leading-relaxed">
                Validasi yang dilakukan pada sisi server ketika menerima request dari frontend, sebelum data
                diproses atau disimpan.
            </p>
            <ul class="mt-2 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>Memastikan data tetap memenuhi aturan meskipun validasi frontend dilewati.</li>
                <li>Memeriksa aturan bisnis dan kondisi data di server atau database.</li>
                <li>Menjadi lapisan validasi yang wajib untuk menjaga integritas dan keamanan data.</li>
                <li>Contoh: memastikan email belum terdaftar dan harga menu lebih dari nol.</li>
            </ul>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Perbandingan</h4>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Aspek</th>
                            <th class="px-3 py-2 font-semibold">Frontend Validation</th>
                            <th class="px-3 py-2 font-semibold">Backend Validation</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Lokasi</td>
                            <td class="px-3 py-2">Browser / aplikasi klien</td>
                            <td class="px-3 py-2">Server / API</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Waktu</td>
                            <td class="px-3 py-2">Sebelum request dikirim</td>
                            <td class="px-3 py-2">Setelah request diterima</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Tujuan utama</td>
                            <td class="px-3 py-2">Umpan balik cepat</td>
                            <td class="px-3 py-2">Menjamin data memenuhi aturan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Contoh pemeriksaan</td>
                            <td class="px-3 py-2">Kolom wajib, format email</td>
                            <td class="px-3 py-2">Keunikan email, aturan bisnis</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Keamanan</td>
                            <td class="px-3 py-2">Dapat dilewati pengguna</td>
                            <td class="px-3 py-2">Tetap wajib dilakukan</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-4 p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Dua lapisan, bukan dua pilihan</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Frontend validation membuat pengalaman pengguna lebih nyaman. Backend validation menjaga
                    integritas data dan keamanan sistem. Jika hanya mengandalkan frontend, aturan bisa dilewati
                    dengan memanggil API secara langsung. Jika hanya mengandalkan backend, pengguna baru tahu
                    kesalahannya setelah menunggu request selesai.
                </p>
            </div>

            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://weqtechnologies.com/frontend-vs-backend-in-2025-key-differences-tools/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">WeQ Technologies: Frontend vs Backend</a>
                        : perbedaan peran frontend dan backend.
                    </li>
                    <li>
                        <a href="https://developer.mozilla.org/en-US/docs/Web/HTML/Constraint_validation" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">MDN: Constraint validation</a>
                        : aturan validasi bawaan HTML dan perilakunya di browser.
                    </li>
                </ul>
            </div>
        </Step>

        <!-- ===== SLIDE 3 ===== -->

        <Step id="s3" diagram="/diagrams/08/slide-3.webp">
            <StepHeader title="Frontend Form Validation" tone="primary" />

            <p class="text-foreground-secondary leading-relaxed">
                <strong>Frontend form validation</strong> adalah proses memeriksa data yang dimasukkan pengguna
                melalui form sebelum data dikirim ke backend. Validasi ini membantu mendeteksi kesalahan sejak
                awal sehingga pengguna dapat langsung memperbaiki input tanpa harus menunggu respons dari
                server.
            </p>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Tujuan Frontend Form Validation</h4>
            <ul class="text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>Memastikan seluruh field wajib telah diisi.</li>
                <li>Memeriksa format dan tipe data sesuai ketentuan.</li>
                <li>Memastikan nilai input berada dalam rentang yang diperbolehkan.</li>
                <li>Menampilkan pesan kesalahan yang jelas dan spesifik.</li>
                <li>Meningkatkan pengalaman pengguna saat mengisi form.</li>
            </ul>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Jenis Validasi pada Form</h4>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Jenis validasi</th>
                            <th class="px-3 py-2 font-semibold">Contoh aturan</th>
                            <th class="px-3 py-2 font-semibold">Implementasi</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Required validation</td>
                            <td class="px-3 py-2">Nama menu tidak boleh kosong</td>
                            <td class="px-3 py-2"><code class={inlineCode}>required</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Format validation</td>
                            <td class="px-3 py-2">Email harus memiliki format yang sesuai</td>
                            <td class="px-3 py-2"><code class={inlineCode}>type="email"</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Length validation</td>
                            <td class="px-3 py-2">Password minimal 8 karakter</td>
                            <td class="px-3 py-2"><code class={inlineCode}>minLength={'{8}'}</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Range validation</td>
                            <td class="px-3 py-2">Harga harus lebih dari 0</td>
                            <td class="px-3 py-2"><code class={inlineCode}>min={'{1}'}</code> atau validasi khusus</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Custom validation</td>
                            <td class="px-3 py-2">Konfirmasi password harus sama</td>
                            <td class="px-3 py-2">Logika JavaScript / React</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <h4 class="mt-5 mb-2 font-semibold text-foreground">Prinsip yang Perlu Diperhatikan</h4>
            <ul class="text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>Pesan error harus spesifik dan mudah dipahami.</li>
                <li>Kesalahan sebaiknya ditampilkan di dekat field yang bermasalah.</li>
                <li>Jangan hanya mengandalkan perubahan warna untuk menandai kesalahan.</li>
                <li>Validasi perlu mempertimbangkan aksesibilitas, misalnya dengan atribut <code class={inlineCode}>aria-invalid</code> dan <code class={inlineCode}>aria-describedby</code>.</li>
            </ul>

            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Kode lengkap ada di Hands-on 1</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Aturan validasi dipisahkan dari komponen form di
                    <code class={inlineCode}>frontend/src/lib/validation.ts</code>. Implementasi lengkap
                    <code class={inlineCode}>validateMenuForm</code> dan
                    <code class={inlineCode}>validateLoginForm</code> dibahas di bagian <strong>Validasi Form</strong>,
                    lalu dipakai oleh <code class={inlineCode}>MenuForm</code> dan
                    <code class={inlineCode}>LoginPage</code>.
                </p>
            </div>

            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
