// `src/docs/openapi.ts` ditampilkan dalam 3 bagian seperti README, dipotong pada
// komentar penanda bagian agar tidak bergantung pada nomor baris.
const [h2OpenapiSchemas, h2OpenapiRoutes, h2OpenapiGenerate] = (() => {
    const lines = h2Openapi.split('\n');
    const idxRoutes = lines.findIndex((line) => /^\/\/ -+ routes$/.test(line));
    const idxGenerate = lines.findIndex((line) => /^\/\/ -+ generate$/.test(line));
    return [
        lines.slice(0, idxRoutes).join('\n').trimEnd(),
        lines.slice(idxRoutes, idxGenerate).join('\n').trimEnd(),
        lines.slice(idxGenerate).join('\n').trimEnd(),
    ];
})();

