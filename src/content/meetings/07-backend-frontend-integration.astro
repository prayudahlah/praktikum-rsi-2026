                            <th class="px-3 py-2 font-semibold">fetch</th>
                            <th class="px-3 py-2 font-semibold">axios</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Instalasi</td>
                            <td class="px-3 py-2">Bawaan browser, tanpa dependency</td>
                            <td class="px-3 py-2">Perlu <code class={inlineCode}>npm install axios</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Body JSON</td>
                            <td class="px-3 py-2">Panggil <code class={inlineCode}>response.json()</code> sendiri</td>
                            <td class="px-3 py-2">Otomatis di-parse dan tersedia di <code class={inlineCode}>response.data</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Error HTTP</td>
                            <td class="px-3 py-2">Tidak reject pada 4xx/5xx; harus cek <code class={inlineCode}>response.ok</code></td>
                            <td class="px-3 py-2">Reject pada status non-2xx</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Timeout</td>
                            <td class="px-3 py-2">Lewat <code class={inlineCode}>AbortController</code></td>
