                            <td class="px-3 py-2">Reject pada status non-2xx</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Timeout</td>
                            <td class="px-3 py-2">Lewat <code class={inlineCode}>AbortController</code></td>
                            <td class="px-3 py-2">Opsi <code class={inlineCode}>timeout</code></td>
