                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2">Akses terproteksi</td>
                            <td class="px-3 py-2">Request biasa, cookie ikut otomatis</td>
                            <td class="px-3 py-2"><code class={inlineCode}>authenticate</code> lalu <code class={inlineCode}>authorize</code></td>
                            <td class="px-3 py-2 font-mono">200 / 401 / 403</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2">Logout</td>
                            <td class="px-3 py-2"><code class={inlineCode}>authApi.logout()</code></td>
                            <td class="px-3 py-2">Hapus cookie</td>
                            <td class="px-3 py-2 font-mono">204</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Respons login tidak berisi token di body. Token ada di cookie:
