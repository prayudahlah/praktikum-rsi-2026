---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';
import { BookOpen } from '@lucide/astro';

import routingSnippet from '../snippets/07/routing.ts?raw';
import axiosClientSnippet from '../snippets/07/axios-client.txt?raw';
import tokenCookieSnippet from '../snippets/07/token-cookie.txt?raw';
import h1ApiGet from '../snippets/07/h1-api-get.ts?raw';
import h1ApiCreate from '../snippets/07/h1-api-create.ts?raw';
import h1ApiUpdate from '../snippets/07/h1-api-update.ts?raw';
import h1ApiDelete from '../snippets/07/h1-api-delete.ts?raw';
import h1UseMenuData from '../snippets/07/h1-use-menu-data.tsx?raw';
import h2HttpInterceptor from '../snippets/07/h2-http-interceptor.ts?raw';
import h2AuthApi from '../snippets/07/h2-auth-api.ts?raw';
import h2MenuApi from '../snippets/07/h2-menu-api.ts?raw';
import h2ProtectedRoute from '../snippets/07/h2-protected-route.tsx?raw';

const repoUrl = 'https://github.com/rrrambatsigma/praktikum-rsi-2026';
const featBranch = 'feat/pertemuan-07-integrasi-fe-be';
const starterBranch = 'starter/pertemuan-07';
const ho1Path = 'pertemuan-07-integrasi-fe-be/hands-on-1-integrasi-fetch-api';
const ho2Path = 'pertemuan-07-integrasi-fe-be/hands-on-2-integrasi-axios-crud';
const ho1Url = `${repoUrl}/tree/${featBranch}/${ho1Path}`;
const ho2Url = `${repoUrl}/tree/${featBranch}/${ho2Path}`;

const cloneProject = `git clone --single-branch --branch ${starterBranch} ${repoUrl}.git praktikum-pert-7`;
const runHo1Backend = `cd praktikum-pert-7/${ho1Path}/backend
Copy-Item .env.example .env
npm install
npm run dev`;
const runHo1Frontend = `cd praktikum-pert-7/${ho1Path}/frontend
Copy-Item .env.example .env
npm install
npm run dev`;
const runHo2Backend = `cd praktikum-pert-7/${ho2Path}/backend
Copy-Item .env.example .env
npm install
npm run dev`;
const runHo2Frontend = `cd praktikum-pert-7/${ho2Path}/frontend
Copy-Item .env.example .env
npm install
npm run dev`;

const folderTree = `praktikum-pert-7/
└─ pertemuan-07-integrasi-fe-be/
   ├─ hands-on-1-integrasi-fetch-api/
   │  ├─ backend/     # Express, SQL Server, Swagger
   │  └─ frontend/    # React, Vite, Fetch API
   └─ hands-on-2-integrasi-axios-crud/
      ├─ backend/     # Express, JWT, RBAC, cookie
      └─ frontend/    # React, Vite, Axios, React Router`;

const fetchExample = `const response = await fetch(API_BASE_URL + '/menu', {
  headers: { Accept: 'application/json' },
});

if (!response.ok) {
  throw new Error('Permintaan gagal: ' + response.status);
}

const payload = await response.json();
const menus = payload.data;`;

const getMenuResponse = `{
  "status": "success",
  "data": [
    {
      "id": 1,
      "stallId": 2,
      "stallName": "Warung Bu Tini",
      "name": "Kwetiau Goreng",
      "price": 15000,
      "isAvailable": true
    }
  ]
}`;

const errorResponse = `{
  "status": "fail",
  "message": "Validasi gagal",
  "errors": [
    {
      "field": "price",
      "message": "price wajib berupa bilangan bulat minimal 0"
    }
  ]
}`;

const menuPayload = `{
  "stallId": 1,
  "name": "Es Jeruk",
  "price": 5000,
  "isAvailable": true
}`;

const loginResponse = `{
  "status": "success",
  "data": {
    "id": 16,
    "name": "Budi Santoso",
    "email": "budi@test.com",
    "role": "customer"
  }
}`;

const inlineCode = 'font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded';

const tocSections: TOCSection[] = [
    {
        label: 'Konsep Integrasi',
        items: [
            { id: 'a1', title: 'Review Arsitektur FE-BE' },
            { id: 'a2', title: 'Client-Server Architecture' },
            { id: 'a3', title: 'REST API & HTTP' },
            { id: 'a4', title: 'Request-Response Cycle' },
        ],
    },
    {
        label: 'Menghubungkan Frontend',
        items: [
            { id: 'a5', title: 'Routing' },
            { id: 'a6', title: 'Fetch dan Axios' },
        ],
    },
    {
        label: 'Hands-on 1: Fetch API',
        items: [
            { id: 'h1', title: 'Setup dan GET' },
            { id: 'h2', title: 'POST: Mengirim Data' },
            { id: 'h3', title: 'PUT/PATCH: Update Data' },
            { id: 'h4', title: 'DELETE: Menghapus Data' },
            { id: 'h5', title: 'Loading, Success, Error' },
        ],
    },
    {
        label: 'Hands-on 2: Axios & Auth',
        items: [
            { id: 'b1', title: 'Axios dan Auth API' },
            { id: 'b2', title: 'Token dan Protected Route' },
        ],
    },
    {
        label: 'Penutup',
        items: [{ id: 'c1', title: 'Integrasi CRUD' }],
    },
];
---

<ScrollySection className="meeting-relaxed">
    <ScrollyLayout defaultSrc="/diagrams/07/slide-1-2.webp">

        <!-- ===== BAGIAN A: KONSEP INTEGRASI ===== -->

        <Step id="a1" diagram="/diagrams/07/slide-1-2.webp">
            <SectionDivider label="Konsep Integrasi" />
            <StepHeader title="Review Arsitektur FE-BE" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Aplikasi web terdiri dari dua pihak yang berjalan di tempat berbeda. <strong>Client</strong> (frontend) berjalan di browser pengguna. Tugasnya
                menampilkan antarmuka dan menerima aksi pengguna. <strong>Server</strong> (backend) berjalan di mesin server. Tugasnya menjalankan logika bisnis,
                memvalidasi input, dan mengakses database.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Keduanya tidak berbagi memori. Satu-satunya cara mereka berkomunikasi adalah
                mengirim pesan lewat jaringan, yaitu <strong>HTTP</strong>. Karena itu frontend
                tidak boleh langsung mengakses database. Semua permintaan data harus lewat API
                yang disediakan backend.
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Pihak</th>
                            <th class="px-3 py-2 font-semibold">Berjalan di</th>
                            <th class="px-3 py-2 font-semibold">Tugas utama</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Client</td>
                            <td class="px-3 py-2">Browser pengguna</td>
                            <td class="px-3 py-2">Menampilkan UI dan menerima aksi pengguna</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Server</td>
                            <td class="px-3 py-2">Mesin server</td>
                            <td class="px-3 py-2">Logika bisnis, validasi, dan akses database</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Analogi</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Frontend adalah pelayan dan buku menu yang dilihat pelanggan. Backend adalah
                    dapur. Database adalah gudang bahan. Pelanggan tidak masuk gudang; ia memesan
                    lewat pelayan, lalu pelayan menyampaikan pesanan ke dapur.
                </p>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Di praktikum ini perannya sudah jelas: React + Vite adalah client, Express adalah
                server, dan SQL Server adalah database. Lima pertemuan pertama itu membangun sisi
                server. Sekarang kita menyambungkan sisi client ke server itu.
            </p>
        </Step>

        <Step id="a2" diagram="/diagrams/07/slide-1-2.webp">
            <StepHeader title="Client-Server Architecture" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                <strong>Client-server architecture</strong> adalah arsitektur yang membagi tugas
                antara dua bagian utama, yaitu client dan server, yang saling berkomunikasi
                melalui jaringan untuk menyediakan layanan atau bertukar data. Client adalah pihak
                yang meminta layanan atau data, sedangkan server adalah pihak yang menerima
                request, memprosesnya, lalu memberikan response.
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Pihak</th>
                            <th class="px-3 py-2 font-semibold">Tugas</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Client</td>
                            <td class="px-3 py-2">
                                <ul class="space-y-0.5 list-disc list-inside">
                                    <li>Mengirim request ke server</li>
                                    <li>Mengirimkan input pengguna</li>
                                    <li>Menerima response</li>
                                    <li>Menampilkan hasil kepada pengguna</li>
                                </ul>
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Server</td>
                            <td class="px-3 py-2">
                                <ul class="space-y-0.5 list-disc list-inside">
                                    <li>Menerima HTTP request</li>
                                    <li>Memvalidasi input</li>
                                    <li>Menjalankan logika bisnis</li>
                                    <li>Mengakses database bila diperlukan</li>
                                    <li>Mengirim HTTP response</li>
                                </ul>
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Database</td>
                            <td class="px-3 py-2">Menyimpan dan mengelola data aplikasi</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Database bukan bagian dari client. Hanya server yang punya koneksi dan kredensial
                database. Kalau browser bisa menyentuh database secara langsung, kredensial itu
                ikut terkirim ke pengguna dan seluruh data bisa dibaca siapa saja.
            </p>
            <div class="mt-4 p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Batas yang tidak boleh dilanggar</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Frontend hanya tahu alamat API dan bentuk datanya. Frontend tidak tahu nama
                    tabel, query SQL, atau password database. Begitu frontend memegang kredensial
                    database, arsitektur client-server sudah tidak lagi dipakai dengan benar.
                </p>
            </div>
        </Step>

        <Step id="a3" diagram="/diagrams/07/slide-3.webp">
            <StepHeader title="REST API & HTTP" tone="primary" />
            <p class="max-w-[42rem] text-foreground-secondary leading-relaxed">
                <strong>HTTP</strong> (Hypertext Transfer Protocol) adalah protokol komunikasi
                yang digunakan untuk mengirimkan data antara client dan server melalui jaringan.
                HTTP mengatur bentuk pesan, metode, status, dan aturan lain yang dipakai kedua
                pihak.
            </p>
            <div class="mt-6 max-w-[42rem] overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="w-[18%] px-3 py-3 font-semibold">Komponen</th>
                            <th class="w-[27%] px-3 py-3 font-semibold">Di praktikum ini</th>
                            <th class="w-[55%] px-3 py-3 font-semibold">Perannya</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary leading-relaxed">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Client</td>
                            <td class="px-3 py-3">React di browser</td>
                            <td class="px-3 py-3">Meminta dan menampilkan data</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Server</td>
                            <td class="px-3 py-3">Express</td>
                            <td class="px-3 py-3">Memproses permintaan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">HTTP</td>
                            <td class="px-3 py-3">Request dan response</td>
                            <td class="px-3 py-3">Aturan komunikasi</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Database</td>
                            <td class="px-3 py-3">SQL Server</td>
                            <td class="px-3 py-3">Menyimpan menu, warung, pengguna, dan pesanan</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-4 max-w-[42rem] text-foreground-secondary leading-relaxed">
                <strong>API</strong> (Application Programming Interface) adalah antarmuka yang
                memungkinkan satu sistem meminta layanan atau data dari sistem lain.
            </p>
            <p class="mt-3 max-w-[42rem] text-foreground-secondary leading-relaxed">
                <strong>REST</strong> (Representational State Transfer) adalah gaya arsitektur
                yang memberikan prinsip tentang bagaimana API dirancang. Jadi, <strong>REST API</strong> adalah salah satu cara merancang API, bukan satu-satunya jenis API.
            </p>
            <div class="mt-6 max-w-[42rem] overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="w-[20%] px-3 py-3 font-semibold">Prinsip REST</th>
                            <th class="w-[38%] px-3 py-3 font-semibold">Artinya</th>
                            <th class="w-[42%] px-3 py-3 font-semibold">Contoh di kantin</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary leading-relaxed">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Resource-based</td>
                            <td class="px-3 py-3">Data direpresentasikan sebagai resource</td>
                            <td class="px-3 py-3"><code class={inlineCode}>menu</code>, <code class={inlineCode}>stalls</code>, <code class={inlineCode}>reviews</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Client-server</td>
                            <td class="px-3 py-3">Frontend menangani tampilan, backend menangani logika dan data</td>
                            <td class="px-3 py-3">React tidak menulis query SQL</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Stateless</td>
                            <td class="px-3 py-3">Setiap request membawa informasi yang diperlukan untuk diproses</td>
                            <td class="px-3 py-3">Server tidak mengingat request sebelumnya untuk memahami request berikutnya</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-3 font-semibold text-foreground">Representasi resource</td>
                            <td class="px-3 py-3">Data dapat dikirim dalam format tertentu</td>
                            <td class="px-3 py-3">JSON: <code class={inlineCode}>{'{ "name": "Kwetiau" }'}</code></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-6 max-w-[42rem] p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Protokol dan gaya arsitektur itu berbeda</span>
                <p class="mt-1 max-w-[42rem] text-sm md:text-base text-foreground-secondary leading-relaxed">
                    HTTP adalah protokol pengiriman pesan. REST adalah gaya merancang API di atas
                    HTTP. Kamu bisa memakai HTTP tanpa membuat API yang RESTful, dan kamu bisa
                    membuat API bergaya lain yang tetap berjalan lewat HTTP.
                </p>
            </div>
        </Step>

        <Step id="a4" diagram="/diagrams/07/slide-4.webp">
            <StepHeader title="Request-Response Cycle" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                <strong>Request-response cycle</strong> adalah proses komunikasi ketika client
                mengirimkan request kepada server, kemudian server memproses permintaan tersebut
                dan mengirimkan response kembali kepada client.
            </p>
            <ol class="mt-3 text-foreground-secondary leading-relaxed space-y-1.5 list-decimal list-inside">
                <li>Client membuat request. Saat pengguna membuka daftar menu, frontend meminta data menu kepada server.</li>
                <li>Request dikirimkan dari client menuju server menggunakan protokol HTTP.</li>
                <li>Server menerima request dan menjalankan proses yang sesuai.</li>
                <li>Setelah selesai, server mengirim response berisi status HTTP, headers, dan terkadang body.</li>
                <li>Frontend membaca response, mengolah datanya, lalu menampilkan daftar menu pada halaman web.</li>
            </ol>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Bagian response</th>
                            <th class="px-3 py-2 font-semibold">Isi</th>
                            <th class="px-3 py-2 font-semibold">Contoh</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Status</td>
                            <td class="px-3 py-2">Kode hasil pemrosesan</td>
                            <td class="px-3 py-2"><code class={inlineCode}>200 OK</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Headers</td>
                            <td class="px-3 py-2">Informasi tambahan tentang response</td>
                            <td class="px-3 py-2"><code class={inlineCode}>Content-Type: application/json</code></td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Body</td>
                            <td class="px-3 py-2">Data yang diminta, jika ada</td>
                            <td class="px-3 py-2"><code class={inlineCode}>{'{ "status": "success", "data": [...] }'}</code></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Kode</th>
                            <th class="px-3 py-2 font-semibold">Arti</th>
                            <th class="px-3 py-2 font-semibold">Muncul saat</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">200</td>
                            <td class="px-3 py-2">OK</td>
                            <td class="px-3 py-2">GET atau PUT berhasil</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">201</td>
                            <td class="px-3 py-2">Created</td>
                            <td class="px-3 py-2">POST berhasil membuat data</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">204</td>
                            <td class="px-3 py-2">No Content</td>
                            <td class="px-3 py-2">DELETE berhasil, tanpa body</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">400</td>
                            <td class="px-3 py-2">Bad Request</td>
                            <td class="px-3 py-2">Validasi gagal atau JSON rusak</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">401</td>
                            <td class="px-3 py-2">Unauthorized</td>
                            <td class="px-3 py-2">Belum login atau sesi kedaluwarsa</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">403</td>
                            <td class="px-3 py-2">Forbidden</td>
                            <td class="px-3 py-2">Sudah login, tetapi role atau kepemilikan tidak cukup</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">404</td>
                            <td class="px-3 py-2">Not Found</td>
                            <td class="px-3 py-2">Data atau endpoint tidak ada</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">409</td>
                            <td class="px-3 py-2">Conflict</td>
                            <td class="px-3 py-2">Bertentangan dengan constraint database</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-mono">500</td>
                            <td class="px-3 py-2">Internal Server Error</td>
                            <td class="px-3 py-2">Kesalahan tak terduga di server</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Contoh nyata: membuka daftar menu</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Browser mengirim <code class={inlineCode}>GET /api/menu</code>. Express
                    mengambil data dari SQL Server, lalu membalas <code class={inlineCode}>200</code> dengan body JSON. React membaca <code class={inlineCode}>response.data.data</code>, menyimpannya di state, dan
                    tabel menu muncul. Tidak ada satu pun baris SQL di browser.
                </p>
            </div>
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
