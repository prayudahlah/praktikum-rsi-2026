                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">localStorage</td>
                            <td class="px-3 py-2">Bertahan setelah browser ditutup</td>
                            <td class="px-3 py-2">Dapat dibaca JavaScript, sehingga rentan XSS</td>
                            <td class="px-3 py-2">Tidak</td>
                        </tr>
