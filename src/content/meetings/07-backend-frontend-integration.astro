                            <td class="px-3 py-2 font-semibold text-foreground">sessionStorage</td>
                            <td class="px-3 py-2">Bertahan selama sesi tab</td>
                            <td class="px-3 py-2">Tetap dapat dibaca JavaScript, sehingga rentan XSS</td>
                            <td class="px-3 py-2">Tidak</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Cookie HttpOnly</td>
