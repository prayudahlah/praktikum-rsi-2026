---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import { BookOpen } from '@lucide/astro';

import dbMixedMode from '../snippets/03/db-00-setup-mixed-mode.sql?raw';
import dbCreateDatabase from '../snippets/03/db-01-create-database-and-user.sql?raw';
import dbSchema from '../snippets/03/db-02-schema.sql?raw';
import dbSeed from '../snippets/03/db-03-seed.sql?raw';

import h1Package from '../snippets/03/h1-package.json?raw';
import h1Tsconfig from '../snippets/03/h1-tsconfig.json?raw';
import h1Env from '../snippets/03/h1-env.txt?raw';
import h1Database from '../snippets/03/h1-database.ts?raw';
import h1Index from '../snippets/03/h1-index.ts?raw';

import h2Package from '../snippets/03/h2-package.json?raw';
import h2DrizzleConfig from '../snippets/03/h2-drizzle-config.ts?raw';
import h2Schema from '../snippets/03/h2-schema.ts?raw';
import h2DbIndex from '../snippets/03/h2-db-index.ts?raw';
import h2Swagger from '../snippets/03/h2-swagger.ts?raw';
import h2StallDto from '../snippets/03/h2-stall-dto.ts?raw';
import h2StallRepository from '../snippets/03/h2-stall-repository.ts?raw';
import h2MenuItemRepository from '../snippets/03/h2-menu-item-repository.ts?raw';
import h2StallService from '../snippets/03/h2-stall-service.ts?raw';
import h2StallController from '../snippets/03/h2-stall-controller.ts?raw';
import h2StallRouter from '../snippets/03/h2-stall-router.ts?raw';
import h2Index from '../snippets/03/h2-index.ts?raw';

const repoUrl = 'https://github.com/rrrambatsigma/praktikum-rsi-2026/tree/main/pertemuan-03-database-backend-crud';

const tocSections: TOCSection[] = [
    {
        label: 'Database & ERD',
        items: [
            { id: 'd1', title: 'Mengapa Database?' },
            { id: 'd2', title: 'ERD & Relasi' },
            { id: 'd3', title: 'Skema Tabel' },
        ],
    },
    {
        label: 'Hands-on 1',
        items: [
            { id: 'h1-1', title: 'Prasyarat & Mixed Mode' },
            { id: 'h1-2', title: 'Database & User Aplikasi' },
            { id: 'h1-3', title: 'Membuat Skema Tabel' },
            { id: 'h1-4', title: 'Mengisi Data Awal (Seed)' },
            { id: 'h1-5', title: 'Setup Project & .env' },
            { id: 'h1-6', title: 'Connection Pool & /health' },
        ],
    },
    {
        label: 'Hands-on 2',
        items: [
            { id: 'h2-1', title: 'Dari Query ke ORM' },
            { id: 'h2-2', title: 'Instalasi Drizzle' },
            { id: 'h2-3', title: 'Schema Drizzle' },
            { id: 'h2-4', title: 'Koneksi Drizzle' },
            { id: 'h2-5', title: 'Repository: Query & CRUD' },
            { id: 'h2-6', title: 'Repository: Join Menu' },
            { id: 'h2-7', title: 'Service: DTO & Bisnis' },
            { id: 'h2-8', title: 'Controller & Router' },
            { id: 'h2-9', title: 'Dokumentasi Swagger' },
        ],
    },
];

const strukturHandsOn1 = `praktikum-pert-3/
├─ db/                               # script SQL (dijalankan di SSMS)
│  ├─ 00-setup-mixed-mode.sql
│  ├─ 01-create-database-and-user.sql
│  ├─ 02-schema.sql
│  └─ 03-seed.sql
├─ package.json
├─ tsconfig.json
├─ .env.example
└─ src/
   ├─ index.ts
   └─ config/
      └─ database.ts`;

const strukturHandsOn2 = `praktikum-pert-3/
├─ package.json
├─ tsconfig.json
├─ .env.example
├─ drizzle.config.ts                 # baru
└─ src/
   ├─ index.ts                       # diubah: daftarkan router + Swagger
   ├─ db/                            # baru
   │  ├─ schema.ts
   │  └─ index.ts
   ├─ docs/                          # baru
   │  ├─ swagger.ts
   │  └─ swagger-output.json         # hasil generate
   ├─ dtos/
   │  └─ stallDto.ts                 # baru
   ├─ repositories/
   │  ├─ stallRepository.ts          # baru
   │  └─ menuItemRepository.ts       # baru
   ├─ services/
   │  └─ stallService.ts             # baru
   ├─ controllers/
   │  └─ stallController.ts          # baru
   └─ routes/
      └─ stallRouter.ts              # baru`;
---

<ScrollySection>
    <ScrollyLayout defaultSrc="/diagrams/03/step1.webp">

        <!-- ===== SECTION 1: DATABASE & ERD ===== -->

        <Step id="d1" diagram="/diagrams/03/step1.webp">
            <SectionDivider label="Database & ERD" />
            <StepHeader title="Mengapa Database?" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Di pertemuan pertama kita mengenal <strong>3-Tier Architecture</strong>, di mana
                <strong class="text-accent"> Database</strong> menempati <em>Data Tier</em>. Di pertemuan kedua,
                data warung masih kita simpan sebagai <em>mock data</em> di dalam sebuah array.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Cara itu cukup untuk belajar, tetapi tidak cukup untuk aplikasi nyata. Saat data bertambah
                banyak, diakses banyak pengguna sekaligus, dan saling berhubungan, kita membutuhkan
                <strong> database</strong>.
            </p>
            <ul class="mt-4 space-y-2 text-foreground-secondary leading-relaxed list-disc list-inside">
                <li><strong>Persisten</strong>: data tetap ada walau server dimatikan atau di-restart.</li>
                <li><strong>Terstruktur</strong>: data disimpan dalam tabel dengan tipe dan aturan yang jelas.</li>
                <li><strong>Query</strong>: pengambilan/filter data yang efisien tanpa membaca semuanya.</li>
                <li><strong>Konsisten</strong>: aturan relasi menjaga data tetap valid (mis. menu tanpa warung).</li>
                <li><strong>Akses bersamaan</strong>: banyak request dapat dilayani dengan aman.</li>
            </ul>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Database yang kita pakai: <strong>SQL Server</strong>, sebuah <em>Relational Database
                Management System</em> (RDBMS) yang menyimpan data dalam tabel-tabel yang saling berelasi.
            </p>
        </Step>

        <Step id="d2" diagram="/diagrams/03/step2.webp">
            <StepHeader title="ERD & Relasi" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Sebelum membuat tabel, kita merancang <strong>ERD</strong> (<em>Entity Relationship
                Diagram</em>), yaitu blueprint yang menggambarkan entitas dan hubungan antar entitas.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Pada studi kasus <strong>"Review Kantin Kampus"</strong>, ada beberapa entitas utama:
            </p>
            <ul class="mt-4 space-y-2 text-foreground-secondary leading-relaxed list-disc list-inside">
                <li><strong>Users</strong>: pengguna aplikasi: <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">admin</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">owner</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">customer</code>.</li>
                <li><strong>Stalls</strong>: warung/kedai yang dimiliki seorang <em>owner</em>.</li>
                <li><strong>Menu Items</strong>: daftar menu milik satu warung.</li>
                <li><strong>Reviews</strong>: ulasan seorang <em>customer</em> terhadap sebuah warung.</li>
                <li><strong>Likes, Flags, Audit Logs</strong>: dukungan interaksi & pelacakan aktivitas.</li>
            </ul>
            <div class="mt-4 p-4 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Kardinalitas (relasi)</span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>Satu <em>user</em> (owner) memiliki <strong>banyak</strong> warung → <strong>1&nbsp;:&nbsp;N</strong>.</li>
                    <li>Satu warung memiliki <strong>banyak</strong> menu → <strong>1&nbsp;:&nbsp;N</strong>.</li>
                    <li>Sebuah review menghubungkan <strong>satu</strong> customer dengan <strong>satu</strong> warung.</li>
                </ul>
            </div>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Relasi diwujudkan lewat <strong>Foreign Key</strong> (kunci asing), yaitu sebuah kolom yang menunjuk
                ke <em>Primary Key</em> tabel lain.
            </p>
        </Step>

        <Step id="d3" diagram="/diagrams/03/step2.webp">
            <StepHeader title="Skema Tabel Review Kantin" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Dari ERD tersebut, kita menerjemahkannya menjadi <strong>7 tabel</strong>. Masing-masing punya
                <em> Primary Key</em> (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">id</code>)
                dan relasi lewat <em>Foreign Key</em>:
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold whitespace-nowrap">Tabel</th>
                            <th class="px-3 py-2 font-semibold">Penjelasan</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">USERS</code>
                            </td>
                            <td class="px-3 py-2">
                                Menyimpan akun pengguna aplikasi. Kolom <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">role</code> membedakan hak akses: <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">admin</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">owner</code> (pemilik warung), dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">customer</code> (pengulas).
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">STALLS</code>
                            </td>
                            <td class="px-3 py-2">
                                Data warung/kedai kantin, terhubung ke pemiliknya lewat <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">owner_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">USERS.id</code>. Menyimpan nama, kategori, lokasi, deskripsi, serta ringkasan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">avg_rating</code> dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">review_count</code>.
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">MENU_ITEMS</code>
                            </td>
                            <td class="px-3 py-2">
                                Daftar menu milik satu warung (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">stall_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">STALLS.id</code>). Tiap menu punya nama, harga, dan status ketersediaan (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">is_available</code>).
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">REVIEWS</code>
                            </td>
                            <td class="px-3 py-2">
                                Ulasan seorang customer terhadap sebuah warung (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">stall_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">STALLS.id</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">user_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">USERS.id</code>), berisi rating 1-5 dan komentar. Satu customer hanya bisa mengulas satu warung sekali (dijaga lewat <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">UNIQUE (user_id, stall_id)</code>).
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">LIKES</code>
                            </td>
                            <td class="px-3 py-2">
                                Mencatat <em>like</em> pada sebuah review (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">review_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">REVIEWS.id</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">user_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">USERS.id</code>); satu user hanya bisa <em>like</em> satu review sekali (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">UNIQUE (review_id, user_id)</code>).
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">FLAGS</code>
                            </td>
                            <td class="px-3 py-2">
                                Laporan/report terhadap sebuah review (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">review_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">REVIEWS.id</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">reported_by</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">USERS.id</code>), berisi alasan dan status tindak lanjut (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">pending</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">resolved</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">dismissed</code>).
                            </td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 whitespace-nowrap">
                                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">AUDIT_LOGS</code>
                            </td>
                            <td class="px-3 py-2">
                                Jejak aktivitas sistem (siapa melakukan apa terhadap data mana; <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">user_id</code> → <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">USERS.id</code>).
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-4 p-4 rounded-lg bg-success/5 dark:bg-success/10 border-2 border-dashed border-success">
                <span class="flex items-center gap-2 font-bold text-success">
                    <BookOpen class="w-4 h-4" />
                    Integritas Data
                </span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Selain PK/FK, tabel memakai <strong>constraint</strong> untuk menjaga validitas:
                    <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">UNIQUE</code> (email & pasangan unik),
                    <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">CHECK</code> (rentang nilai),
                    dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">DEFAULT</code> (nilai bawaan).
                </p>
            </div>
        </Step>

        <!-- ===== SECTION 2: HANDS-ON 1 ===== -->

        <Step id="h1-1" diagram="/diagrams/03/hands-on.webp">
            <SectionDivider label="Hands-on 1" />
            <StepHeader title="Prasyarat & Mengaktifkan Mixed Mode" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                Hands-on pertama menyiapkan database SQL Server untuk aplikasi <strong>Review Kantin
                Kampus</strong>, lalu menghubungkannya dari backend.
            </p>
            <a href={repoUrl}
               target="_blank" rel="noopener noreferrer"
               class="my-3 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline">
                <img src="/icons/github.svg" alt="" aria-hidden="true" class="w-4 h-4 invert-0 dark:invert" />
                Kode Hands-on di GitHub
            </a>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Struktur folder yang akan kita buat:
            </p>
            <CodeBlock code={strukturHandsOn1} language="bash" />
            <p class="text-foreground-secondary leading-relaxed">
                Secara default, SQL Server hanya menerima login Windows. Driver <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">mssql</code>
                di aplikasi nanti akan masuk memakai <strong>SQL Authentication</strong> (username + password),
                jadi kita perlu mengaktifkan <strong>mixed mode</strong>:
            </p>
            <div class="mt-3 p-4 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Cara menjalankan (SSMS)</span>
                <ol class="text-sm md:text-base text-foreground-secondary mt-2 space-y-1 list-decimal list-inside">
                    <li>Buka file <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">db/00-setup-mixed-mode.sql</code> di <strong>SSMS</strong> (File → Open → File...), atau editor SQL lain (mis. Azure Data Studio).</li>
                    <li>Terhubung sebagai <strong>Windows Authentication</strong>, lalu klik <strong>Execute</strong> (F5).</li>
                </ol>
            </div>
            <CodeBlock code={dbMixedMode} language="sql" filename="db/00-setup-mixed-mode.sql" compact />
            <p class="text-foreground-secondary leading-relaxed">
                Script mengubah <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">LoginMode</code>
                di registry. Agar berlaku, <strong>restart service</strong> SQL Server. Di SSMS, klik kanan nama server
                di <em>Object Explorer</em> → <strong>Restart</strong> (atau lewat SQL Server Configuration Manager).
            </p>
            <div class="mt-4 p-4 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Pastikan TCP/IP aktif</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Driver <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">mssql</code>
                    terhubung lewat <strong>TCP port 1433</strong>. Aktifkan lewat SQL Server Configuration Manager →
                    <em> Protocols → TCP/IP → Enabled</em>, lalu restart service. Untuk named instance, cara paling aman
                    mengaktifkan mixed mode adalah lewat SSMS: <em>Server Properties → Security</em>.
                </p>
            </div>
        </Step>

        <Step id="h1-2" diagram="/diagrams/03/hands-on.webp">
            <StepHeader title="Membuat Database & User Aplikasi" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                Selanjutnya kita membuat database <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">review_kantin</code>
                dan login aplikasi <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">praktikum_user</code>
                beserta hak baca-tulis. Jalankan sebagai sysadmin:
            </p>
            <p class="text-foreground-secondary leading-relaxed">
                Buka <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">db/01-create-database-and-user.sql</code>
                di SSMS, lalu klik <strong>Execute</strong> (F5).
            </p>
            <CodeBlock code={dbCreateDatabase} language="sql" filename="db/01-create-database-and-user.sql" compact />
            <p class="text-foreground-secondary leading-relaxed">
                Aplikasi kita <strong>tidak</strong> memakai akun sysadmin, melainkan user khusus dengan hak
                terbatas (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">db_datareader</code> +
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">db_datawriter</code>), yaitu
                prinsip <em>least privilege</em>.
            </p>
