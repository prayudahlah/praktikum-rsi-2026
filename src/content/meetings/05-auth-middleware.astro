---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import { BookOpen } from '@lucide/astro';

import jwtPayload from '../snippets/05/c-jwt-payload.json?raw';
import tokenService from '../snippets/05/c-token-service.ts?raw';
import middlewareChain from '../snippets/05/c-middleware-chain.ts?raw';
import diSnippet from '../snippets/05/c-di.ts?raw';
import authSchema from '../snippets/05/c-auth-schema.ts?raw';
import authService from '../snippets/05/c-auth-service.ts?raw';
import authRouter from '../snippets/05/c-auth-router.ts?raw';
import unauthorizedError from '../snippets/05/c-unauthorized-error.ts?raw';
import authMiddleware from '../snippets/05/c-auth-middleware.ts?raw';
import authorizeMw from '../snippets/05/c-authorize.ts?raw';
import forbiddenError from '../snippets/05/c-forbidden-error.ts?raw';
import expressTypes from '../snippets/05/c-express-d.ts?raw';
import protectedRoutes from '../snippets/05/c-protected-routes.ts?raw';
import stallService from '../snippets/05/c-stall-service.ts?raw';
import reviewSchema from '../snippets/05/c-review-schema.ts?raw';

const repoUrl = 'https://github.com/rrrambatsigma/praktikum-rsi-2026';
const mainUrl = `${repoUrl}/tree/main/pertemuan-05-auth-middleware`;

const tocSections: TOCSection[] = [
    {
        label: 'Konsep Autentikasi',
        items: [
            { id: 'a1', title: 'Kamu itu Siapa?' },
            { id: 'a2', title: 'Autentikasi vs Otorisasi' },
            { id: 'a3', title: 'Session vs JWT' },
            { id: 'a4', title: 'Cara Kerja JWT' },
            { id: 'a5', title: 'Middleware Dasar' },
        ],
    },
    {
        label: 'Hands-on 1',
        items: [
            { id: 'h1-1', title: 'Ambil Starter' },
            { id: 'h1-2', title: 'Install & Konfigurasi' },
            { id: 'h1-3', title: 'Schema Auth' },
            { id: 'h1-4', title: 'Hash Password & Token' },
            { id: 'h1-5', title: 'Register, Login, Router' },
            { id: 'h1-6', title: 'Uji Autentikasi' },
        ],
    },
    {
        label: 'Konsep Middleware & Otorisasi',
        items: [
            { id: 'b1', title: 'Auth Middleware' },
            { id: 'b2', title: 'Parameterized Middleware' },
            { id: 'b3', title: 'Protected Routes' },
            { id: 'b4', title: 'Mengelola Ketergantungan (DI)' },
        ],
    },
    {
        label: 'Hands-on 2',
        items: [
            { id: 'h2-1', title: 'Ambil Starter' },
            { id: 'h2-2', title: 'Auth & Authorize' },
            { id: 'h2-3', title: 'Pasang ke Route' },
            { id: 'h2-4', title: 'Kepemilikan Objek & Review' },
            { id: 'h2-5', title: 'Uji 401 vs 403' },
        ],
    },
    {
        label: 'Penutup',
        items: [{ id: 'c1', title: 'Recap' }],
    },
];

const cloneStarter = `git clone --single-branch --branch starter/pertemuan-05 https://github.com/rrrambatsigma/praktikum-rsi-2026.git praktikum-pert-5`;

const sampleRegisterResponse = `{
  "status": "success",
  "data": {
    "user": { "id": 16, "name": "Budi Santoso", "email": "budi@test.com", "role": "customer" }
  }
}`;

const sampleLoginResponse = `{
  "status": "success",
  "data": {
    "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxIiwibmFtZSI6IkFkbWlu...",
    "tokenType": "Bearer",
    "expiresIn": "2h",
    "user": { "id": 1, "name": "Admin Kantin", "email": "admin@kantin.test", "role": "admin" }
  }
}`;

const sampleMe = `{
  "status": "success",
  "data": { "id": 12, "name": "Bagas Pratama", "email": "bagas@student.test", "role": "customer" }
}`;

const sampleUnauthorized = `{
  "status": "fail",
  "message": "Header Authorization dengan token Bearer wajib dikirim"
}`;

const sampleForbidden = `{
  "status": "fail",
  "message": "Endpoint ini hanya untuk role: admin"
}`;

const sampleOwnershipForbidden = `{
  "status": "fail",
  "message": "Kamu hanya bisa mengubah warung milikmu sendiri"
}`;
---

<ScrollySection>
    <ScrollyLayout defaultSrc="/diagrams/05/kamu-siapa.webp">

        <!-- ===== BAGIAN A: KONSEP AUTENTIKASI ===== -->

        <Step id="a1" diagram="/diagrams/05/kamu-siapa.webp">
            <SectionDivider label="Konsep Autentikasi" />
            <StepHeader title="Kamu itu Siapa?" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                API Review Kantin sudah jalan sejak pertemuan 4. Ada endpoint untuk melihat daftar
                warung, menambah warung, dan menghapus warung. Pertanyaannya, <strong>siapa yang
                boleh mengakses itu semua?</strong>
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Kalau dibiarkan terbuka, siapa pun yang tahu alamat endpoint-nya bisa{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">DELETE /api/v1/stalls/1</code>{' '}
                dan menghapus warung orang lain. Cukup buka Postman, kirim request, beres.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Masalahnya, server HTTP itu buta. Yang diteruskannya ke aplikasi hanya method, path,
                header, dan body. Tidak ada konsep "user" di dalam HTTP. Orang yang menekan tombol di
                aplikasi, orang yang mengirim <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">curl</code>,
                dan bot yang menebak endpoint, semuanya terlihat sama: sekumpulan byte.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Jadi server butuh cara untuk <strong>mengenali identitas</strong> pengirim request,
                lalu <strong>memutuskan boleh atau tidak</strong> aksi tertentu dilakukan. Di pertemuan
                ini kita belajar keduanya.
            </p>
        </Step>

        <Step id="a2" diagram="/diagrams/05/autentikasi-vs-otorisasi.webp">
            <StepHeader title="Autentikasi vs Otorisasi" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Dua hal ini berbeda, tetapi sering tertukar:
            </p>
            <ul class="mt-3 text-foreground-secondary leading-relaxed space-y-2 list-disc list-inside">
                <li>
                    <strong>Autentikasi</strong> bertanya "kamu siapa?". Proses login dan verifikasi
                    identitas. Kalau gagal, server belum tahu kamu siapa, dan jawabannya{' '}
                    <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">401</code>.
                </li>
                <li>
                    <strong>Otorisasi</strong> bertanya "kamu boleh apa?". Server sudah tahu kamu
                    siapa, lalu memeriksa hak akses atau role. Kalau gagal, jawabannya{' '}
                    <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">403</code>.
                </li>
            </ul>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Urutannya wajib <strong>autentikasi dulu, baru otorisasi</strong>. Tidak mungkin
                memeriksa hak akses kalau belum tahu siapa user-nya.
            </p>
            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Analogi</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Autentikasi seperti menunjukkan KTP di pintu masuk. Otorisasi seperti petugas yang
                    memeriksa apakah KTP itu boleh masuk ruang server.
                </p>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Di JWT, token menjadi bukti autentikasi. Role di dalam token dipakai untuk otorisasi.
            </p>
        </Step>

        <Step id="a3" diagram="/diagrams/05/session-jwt.webp">
            <StepHeader title="Session vs JWT" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Ada dua cara server "mengingat" user yang sudah login:
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold whitespace-nowrap">Aspek</th>
                            <th class="px-3 py-2 font-semibold">Session</th>
                            <th class="px-3 py-2 font-semibold">JWT</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Data login</td>
                            <td class="px-3 py-2">Disimpan di server (memori/database)</td>
                            <td class="px-3 py-2">Disimpan di token, dikirim ke client</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Yang dikirim client</td>
                            <td class="px-3 py-2">ID session (biasanya cookie)</td>
                            <td class="px-3 py-2">Token lengkap</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Pemeriksaan</td>
                            <td class="px-3 py-2">ID dicocokkan ke penyimpanan server</td>
                            <td class="px-3 py-2">Signature token diverifikasi</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Skala</td>
                            <td class="px-3 py-2">Perlu penyimpanan bersama antar server</td>
                            <td class="px-3 py-2">Stateless, mudah di-scale</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Di pertemuan ini kita <strong>menjelaskan keduanya, tetapi mengimplementasikan JWT
                saja</strong>. Alasannya, JWT cocok untuk API: stateless, bisa dipakai frontend web
                maupun mobile, dan datanya sudah ada di dalam token.
            </p>
            <div class="mt-4 p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Kekurangan JWT</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Token tidak bisa dicabut sebelum kedaluwarsa. Kalau token bocor, token itu tetap
                    sah sampai <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">exp</code>-nya lewat.
                    Karena itu umur token dibuat pendek.
                </p>
            </div>
        </Step>

        <Step id="a4" diagram="/diagrams/05/cara-kerja-jwt.webp">
            <StepHeader title="Cara Kerja JWT" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                JWT itu string panjang berisi tiga bagian yang dipisah titik:{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">header.payload.signature</code>.
            </p>
            <ul class="mt-3 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li><strong>Header</strong>: tipe token dan algoritma, biasanya <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">HS256</code>.</li>
                <li><strong>Payload</strong>: data user (id, name, email, role) plus <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">iat</code> dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">exp</code>.</li>
                <li><strong>Signature</strong>: hasil HMAC dari header + payload + secret. Ini yang membuat token tidak bisa dipalsukan.</li>
            </ul>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Payload hanya <strong>di-encode</strong> (base64url), bukan dienkripsi. Siapa pun yang
                memegang token bisa membacanya. Jadi <strong>jangan pernah menaruh password</strong> di
                payload.
            </p>
            <CodeBlock code={jwtPayload} language="json" filename="payload JWT (hasil decode)" compact />
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Alur pakainya: user login, server membuat token, client menyimpan token, lalu setiap
                request ke endpoint terlindungi mengirim header{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">Authorization: Bearer &lt;token&gt;</code>.
                Server memverifikasi signature dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">exp</code>.
                Kalau valid, request lanjut. Kalau tidak, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">401</code>.
            </p>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Di kode, dua fungsi inilah inti JWT:
            </p>
            <CodeBlock code={tokenService} language="typescript" filename="src/services/tokenService.ts" />
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://datatracker.ietf.org/doc/html/rfc7519" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">RFC 7519 JSON Web Token</a>
                        : spesifikasi resmi, termasuk makna <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">exp</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">iat</code>, dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">sub</code>.
                    </li>
                    <li>
                        <a href="https://www.npmjs.com/package/jsonwebtoken" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">npm: jsonwebtoken</a>
                        : API <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">sign</code> dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">verify</code>, daftar error.
                    </li>
                </ul>
            </div>
        </Step>

        <Step id="a5" diagram="/diagrams/05/middleware-dasar.webp">
            <StepHeader title="Middleware Dasar" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Sejak pertemuan 4 kita sudah kenal middleware: gerbang sebelum controller. Kali ini
                middleware dipakai untuk hal baru, yaitu <strong>memeriksa token</strong>.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Sebelum request masuk ke controller, middleware memeriksa: ada token di header atau
                tidak, dan token-nya valid atau tidak. Kalau tidak ada atau tidak valid, request
                langsung ditolak, controller tidak pernah kebagian. Kalau valid, data user disimpan
                ke <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">req.user</code>{' '}
                supaya handler berikutnya tidak perlu mengurai token lagi.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Kenapa di middleware, bukan di controller? Karena <strong>sekali ditulis, dipakai di
                semua endpoint</strong>. Kalau cara memeriksa token berubah, cukup ubah satu tempat.
            </p>
            <CodeBlock code={middlewareChain} language="typescript" filename="urutan middleware per endpoint" compact />
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://expressjs.com/en/guide/using-middleware.html" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Using middleware (Express)</a>
                        : cara kerja dan urutan pemasangan middleware.
                    </li>
                </ul>
            </div>
        </Step>

        <!-- ===== HANDS-ON 1 ===== -->

        <Step id="h1-1" diagram="/diagrams/05/hands-on.webp">
            <SectionDivider label="Hands-on 1" />
            <StepHeader title="Ambil Starter" tone="success" />
            <p class="text-foreground-secondary leading-relaxed">
                Kita tidak mulai dari nol. Titik awal Hands-on 1 adalah project pertemuan 4{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">hands-on-2</code>
                (validasi zod + error handling + Swagger), yang belum punya autentikasi sama sekali.
                Supaya titik mulainya jelas, titik awal itu disediakan di branch{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">starter/pertemuan-05</code>.
            </p>
            <TerminalBlock code={cloneStarter} title="Terminal: Clone starter Pertemuan 05" />
            <p class="text-foreground-secondary leading-relaxed">
                Hasil clone hanya berisi Pertemuan 5 dalam kondisi awal:
            </p>
            <CodeBlock
                code={`praktikum-pert-5/
└─ pertemuan-05-auth-middleware/
   ├─ db/seed-password-hashes.sql          # jalankan sekali sebelum mulai
   ├─ hands-on-1-autentikasi-jwt/          # titik awal Hands-on 1
   └─ hands-on-2-middleware-otorisasi/     # titik awal Hands-on 2`}
                language="bash"
                compact
            />
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Masuk ke folder Hands-on 1. Semua langkah berikut dijalankan dari dalam folder ini.
            </p>
            <TerminalBlock code={`cd praktikum-pert-5/pertemuan-05-auth-middleware/hands-on-1-autentikasi-jwt`} title="Terminal: Masuk folder Hands-on 1" />
            <a href={mainUrl}
               target="_blank" rel="noopener noreferrer"
               class="my-3 inline-flex items-center gap-2 text-sm font-medium text-primary hover:underline">
                <img src="/icons/github.svg" alt="" aria-hidden="true" class="w-4 h-4 invert-0 dark:invert" />
                Versi jadi di GitHub (branch main)
            </a>
        </Step>

        <Step id="h1-2" diagram="/diagrams/05/hands-on.webp">
            <StepHeader title="Install & Konfigurasi" tone="success" />
            <TerminalBlock code={`npm install\nnpm install jsonwebtoken bcryptjs\nnpm install -D @types/jsonwebtoken`} title="Terminal: Install dependensi" />
            <p class="text-foreground-secondary leading-relaxed">
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">bcryptjs</code> v3 sudah membawa tipe sendiri, jadi cukup{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">@types/jsonwebtoken</code> untuk{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">jsonwebtoken</code>.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Salin file <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">.env.example</code> menjadi{' '}
                <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">.env</code>.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Lalu tambahkan tiga variabel autentikasi ke <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">.env</code>{' '}
                dan <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">.env.example</code>:
            </p>
            <CodeBlock
                code={`JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=10`}
                language="ini"
                filename=".env (tambahan)"
                compact
            />
            <ul class="mt-3 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li><code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">JWT_SECRET</code>: kunci HMAC penanda tangan token. Nilainya bebas, dan wajib diganti di produksi. Kalau bocor, penyerang bisa membuat token palsu.</li>
                <li><code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">JWT_EXPIRES_IN</code>: umur token (<code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">2h</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">30m</code>, <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">7d</code>).</li>
                <li><code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">BCRYPT_SALT_ROUNDS</code>: jumlah iterasi hashing bcrypt.</li>
            </ul>
            <div class="mt-4 p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Jangan lupa seed password</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Seed Pertemuan 03 masih memakai placeholder <code class="font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded">hash_admin</code>,
                    bukan hash bcrypt. Jalankan skrip{' '}
