---
import {
    ScrollySection,
    Step,
    StepHeader,
    SectionDivider,
    ScrollyLayout,
    ScrollyTOC,
} from '../../components/scrolly';
import type { TOCSection } from '../../components/scrolly';
import CodeBlock from '../../components/ui/CodeBlock.astro';
import TerminalBlock from '../../components/ui/TerminalBlock.astro';
import { BookOpen } from '@lucide/astro';

import headerSnippet from '../snippets/06/c-header.txt?raw';
import menuCardSnippet from '../snippets/06/c-menu-card.txt?raw';
import menuDetailSnippet from '../snippets/06/c-menu-detail-modal.txt?raw';
import cartPanelSnippet from '../snippets/06/c-cart-panel.txt?raw';
import appStateSnippet from '../snippets/06/c-app-state.txt?raw';
import appCartSnippet from '../snippets/06/c-app-cart.txt?raw';
import appRenderSnippet from '../snippets/06/c-app-render.txt?raw';
import formatSnippet from '../snippets/06/c-format.txt?raw';
import dashboardSnippet from '../snippets/06/c-dashboard.txt?raw';
import dashboardHeaderSnippet from '../snippets/06/c-dashboard-header.txt?raw';
import orderStatsSnippet from '../snippets/06/c-order-stats.txt?raw';
import orderListSnippet from '../snippets/06/c-order-list.txt?raw';
import orderCardSnippet from '../snippets/06/c-order-card.txt?raw';

const repoUrl = 'https://github.com/rrrambatsigma/praktikum-rsi-2026';
const starterUrl = `${repoUrl}/tree/starter/pertemuan-06/pertemuan-06-frontend-dasar`;
const mainUrlHo1 = `${repoUrl}/tree/feat/pertemuan-6/pertemuan-06-frontend-dasar/hands-on-1-reactprop`;
const mainUrlHo2 = `${repoUrl}/tree/feat/pertemuan-6/pertemuan-06-frontend-dasar/hands-on-2-dashboard`;
const cloneStarter = `git clone --single-branch --branch starter/pertemuan-06 ${repoUrl}.git praktikum-pert-6`;

const inlineCode = 'font-mono text-[0.9em] bg-zinc-100 dark:bg-zinc-800 px-1.5 py-0.5 rounded';

const tocSections: TOCSection[] = [
    {
        label: 'Konsep Frontend',
        items: [
            { id: 'a1', title: 'Frontend: Bagian yang Kamu Sentuh' },
            { id: 'a2', title: 'Memecah UI jadi Komponen' },
            { id: 'a3', title: 'React: UI dari Data' },
            { id: 'a4', title: 'JSX dan TSX' },
            { id: 'a5', title: 'Props dan Reusability' },
            { id: 'a6', title: 'Struktur Project React' },
            { id: 'a7', title: 'Tailwind dan Design Token' },
        ],
    },
    {
        label: 'Hands-on 1',
        items: [
            { id: 'h1-1', title: 'Ambil Starter' },
            { id: 'h1-2', title: 'Kenali Starter' },
            { id: 'h1-3', title: 'Header dan Pencarian' },
            { id: 'h1-4', title: 'MenuCard dan Data' },
            { id: 'h1-5', title: 'State, Aksi, dan Tampilan' },
            { id: 'h1-6', title: 'Uji Katalog' },
            { id: 'h1-7', title: 'Modal Detail Menu' },
            { id: 'h1-8', title: 'Keranjang' },
        ],
    },
    {
        label: 'Hands-on 2',
        items: [
            { id: 'h2-1', title: 'Ambil Starter Dashboard' },
            { id: 'h2-2', title: 'DashboardHeader dan Layout' },
            { id: 'h2-3', title: 'OrderStats' },
            { id: 'h2-4', title: 'OrderList dan OrderCard' },
            { id: 'h2-5', title: 'Uji Ubah Status' },
        ],
    },
    {
        label: 'Penutup',
        items: [{ id: 'c1', title: 'Recap' }],
    },
];

const jsxExample = `function MenuCard() {
  return (
    <article className="rounded-xl border p-4">
      <h3>Nasi Goreng</h3>
      <p>Rp15.000</p>
    </article>
  )
}`;

const compiledJsx = `// kurang lebih seperti ini hasil kompilasinya
function MenuCard() {
  return jsx('article', {
    className: 'rounded-xl border p-4',
    children: [
      jsx('h3', { children: 'Nasi Goreng' }),
      jsx('p', { children: 'Rp15.000' }),
    ],
  })
}`;

const plainDom = `const label = document.querySelector('#label-keranjang')

// setiap kali data berubah, kita harus ingat memperbarui tampilan
label.textContent = \`Keranjang: \${jumlah} item\``;

const reactState = `function Keranjang() {
  const [jumlah, setJumlah] = useState(0)

  return (
    <button onClick={() => setJumlah(jumlah + 1)}>
      Keranjang: {jumlah} item
    </button>
  )
}`;

const tsxProps = `type MenuCardProps = {
  nama: string
  harga: number
  tersedia: boolean
}

function MenuCard({ nama, harga, tersedia }: MenuCardProps) {
  return (
    <article>
      <h3>{nama}</h3>
      <p>Rp{harga.toLocaleString('id-ID')}</p>
      {!tersedia && <span>Habis</span>}
    </article>
  )
}`;

const utilityExample = `/* CSS biasa: satu nama class, isinya banyak aturan */
.kartu-menu {
  border-radius: 1rem;
  border: 1px solid #f0e3db;
  background: #ffffff;
  padding: 1rem;
}

/* Tailwind: aturan kecil yang disusun langsung di elemen */
<article className="rounded-2xl border border-border bg-surface p-4">`;

const tokenExample = `@import "tailwindcss";

@theme {
  --color-page: #fff8f4;
  --color-surface: #ffffff;
  --color-text: #29231f;
  --color-muted: #796a61;
  --color-primary: #b84208;
  --color-border: #f0e3db;
}`;

const propsFlow = `function Catalog() {
  return (
    <div>
      {menuItems.map((menu) => (
        <MenuCard
          key={menu.id}
          menu={menu}
          onSelect={setSelectedMenu}
        />
      ))}
    </div>
  )
}

function MenuCard({ menu, onSelect }: MenuCardProps) {
  return (
    <button onClick={() => onSelect(menu)}>
      {menu.name}
    </button>
  )
}`;

const structureExample = `praktikum-pert-6/
└─ hands-on-1-katalog-menu/
   ├─ public/
   │  └─ images/                 # foto menu, logo
   ├─ src/
   │  ├─ components/             # potongan UI yang dipakai berulang
   │  ├─ data/                   # data contoh dan tipenya
   │  ├─ lib/                    # fungsi bantu, misal format rupiah
   │  ├─ pages/                  # halaman yang menyusun komponen
   │  ├─ App.tsx                 # pintu masuk tampilan
   │  ├─ main.tsx                # memasang React ke HTML
   │  └─ index.css               # Tailwind dan design token
   ├─ index.html
   ├─ package.json
   ├─ tsconfig.json
   └─ vite.config.ts`;
---

<ScrollySection>
    <ScrollyLayout defaultSrc="/diagrams/06/perkenalan-frontend.webp">

        <!-- ===== BAGIAN A: KONSEP FRONTEND ===== -->

        <Step id="a1" diagram="/diagrams/06/perkenalan-frontend.webp">
            <SectionDivider label="Konsep Frontend" />
            <StepHeader title="Frontend: Bagian yang Kamu Sentuh" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Selama lima pertemuan, semua yang kita bangun ada di sisi server. Ada database,
                ada endpoint, ada token. Semuanya bekerja, tetapi tidak ada yang bisa dilihat
                pengguna. Yang terlihat hanya Postman dan terminal.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Hari ini kita pindah ke sisi yang berlawanan. <strong>Frontend</strong> adalah
                bagian aplikasi yang berinteraksi langsung dengan pengguna. Tugasnya menampilkan
                informasi, menerima input, dan menyampaikan permintaan ke backend.
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Tugas</th>
                            <th class="px-3 py-2 font-semibold">Contoh di sistem kantin</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Menampilkan data</td>
                            <td class="px-3 py-2">Daftar warung, daftar menu, harga, status ketersediaan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Menerima input</td>
                            <td class="px-3 py-2">Kotak pencarian, pilihan kategori, jumlah pesanan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Mengirim permintaan</td>
                            <td class="px-3 py-2">Menyimpan pesanan, mengubah status pesanan</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Mengolah jawaban</td>
                            <td class="px-3 py-2">Menampilkan pesan berhasil, pesan gagal, atau data kosong</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Kalau kamu membayangkan sistem kantin, halaman yang kamu lihat semuanya frontend:
                login, beranda, daftar menu, detail menu, profil, keranjang, dan riwayat pesanan.
                Di pertemuan ini kita membuat dua di antaranya, yaitu katalog menu dan dashboard
                pesanan.
            </p>
            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Analogi</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Frontend itu meja makan dan buku menu. Pengunjung melihat menu, memilih, dan
                    memanggil pelayan di sana. Dapur, gudang, dan aturan memasak tetap di belakang.
                    Pengunjung tidak perlu tahu bagaimana nasi goreng dibuat, tetapi meja yang
                    berantakan membuat pengalaman makan jadi buruk.
                </p>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Satu hal yang sering keliru: frontend <strong>bukan</strong> tempat menyimpan aturan
                bisnis. Validasi di frontend berguna supaya pengguna cepat tahu kesalahannya, tetapi
                keputusan tetap milik backend. Ingat pertemuan 4, server tidak boleh mempercayai
                data dari client. Frontend pun tidak boleh dianggap sebagai penjaga.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Di pertemuan ini frontend belum tersambung ke API. Datanya masih lokal, karena
                menyambung frontend ke backend adalah materi pertemuan 7.
            </p>
        </Step>

        <Step id="a2" diagram="/diagrams/06/component-based-architecture.webp">
            <StepHeader title="Memecah UI jadi Komponen" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Bayangkan satu file <code class={inlineCode}>App.tsx</code> berisi seluruh halaman: header, pencarian, daftar
                menu, detail menu, keranjang, dan footer. Panjangnya bisa ratusan baris. Saat ada
                dua menu yang tampilannya sama, markup-nya disalin. Saat warna tombol berubah, kamu
                harus mencari semua salinannya.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                <strong>Component Based Architecture</strong> adalah pendekatan memecah antarmuka
                menjadi bagian kecil yang punya tanggung jawab jelas dan bisa dipakai ulang.
                Komponen adalah bagian UI yang dibuat terpisah, lalu disusun bersama komponen lain
                untuk membentuk halaman.
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
                            <th class="px-3 py-2 font-semibold">Alasan</th>
                            <th class="px-3 py-2 font-semibold">Arti sederhananya</th>
                            <th class="px-3 py-2 font-semibold">Contoh di katalog</th>
                        </tr>
                    </thead>
                    <tbody class="text-foreground-secondary">
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Modularity</td>
                            <td class="px-3 py-2">Aplikasi terbagi jadi bagian kecil dengan fungsi tertentu</td>
                            <td class="px-3 py-2">Header, MenuCard, CartPanel</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Abstraction</td>
                            <td class="px-3 py-2">Detail di dalam disembunyikan, cukup tahu cara memakainya</td>
                            <td class="px-3 py-2">Cukup menulis <code class={inlineCode}>&lt;Button /&gt;</code>, tidak perlu tahu kelas Tailwind-nya</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Encapsulation</td>
                            <td class="px-3 py-2">Data dan logika yang berkaitan dikelola di dalam komponen itu</td>
                            <td class="px-3 py-2">Status gambar gagal disimpan di dalam MenuCard</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Reusability</td>
                            <td class="px-3 py-2">Komponen dipakai lagi tanpa dibuat dari nol</td>
                            <td class="px-3 py-2">Sembilan menu memakai satu MenuCard yang sama</td>
                        </tr>
                        <tr class="border-t border-border align-top">
                            <td class="px-3 py-2 font-semibold text-foreground">Separation of Concern</td>
                            <td class="px-3 py-2">Setiap bagian punya tanggung jawab yang tidak tercampur</td>
                            <td class="px-3 py-2">Data di <code class={inlineCode}>data/</code>, format harga di <code class={inlineCode}>lib/</code></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Hasil akhirnya seperti pohon. Halaman katalog menyusun Header, daftar MenuCard, dan
                CartPanel. Setiap komponen bisa dibaca sendiri tanpa harus memahami seluruh
                aplikasi.
            </p>
            <div class="mt-4 p-3 rounded-lg bg-warning/5 dark:bg-warning/10 border-l-4 border-warning">
                <span class="font-bold text-warning">Jangan memecah terlalu cepat</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    Komponen lahir karena ada pengulangan atau karena tanggung jawabnya jelas,
                    bukan karena setiap kotak harus jadi file baru. Memecah berlebihan justru
                    membuat alur data sulit diikuti.
                </p>
            </div>
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://react.dev/learn/thinking-in-react" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Thinking in React</a>
                        : cara memecah antarmuka menjadi komponen berdasarkan data dan tanggung jawab.
                    </li>
                </ul>
            </div>
        </Step>

        <Step id="a3" diagram="/diagrams/06/how_doest_react_js_work.webp">
            <StepHeader title="React: UI dari Data" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                React adalah library JavaScript untuk membangun antarmuka yang interaktif dan
                berbasis komponen. React bukan framework penuh. Dia tidak mengatur routing,
                database, atau struktur folder. Dia fokus pada satu hal: menjaga tampilan tetap
                sesuai dengan data.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Cara berpikirnya bisa ditulis singkat sebagai <strong>UI adalah fungsi dari
                data</strong>. Kalau datanya berubah, tampilan ikut berubah. Kamu tidak perlu
                mencari elemen lalu mengubah isinya satu per satu.
            </p>
            <p class="mt-4 text-foreground-secondary leading-relaxed">
                Cara lama, mengubah DOM secara manual:
            </p>
            <CodeBlock code={plainDom} language="ts" filename="cara imperatif (bukan React)" compact />
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Cara React, cukup nyatakan tampilan untuk suatu nilai:
            </p>
            <CodeBlock code={reactState} language="tsx" filename="Keranjang.tsx" compact />
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Di contoh kedua, tidak ada perintah "ubah teks tombol". Kita hanya mengubah
                <code class={inlineCode}>jumlah</code>, lalu React memperbarui tampilan yang
                memakainya. Inilah yang disebut deklaratif.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                React tidak menulis ulang seluruh halaman setiap kali data berubah. Ia membandingkan
                hasil render baru dengan hasil sebelumnya lewat representasi ringan yang disebut
                Virtual DOM, lalu hanya memperbarui bagian yang benar-benar berbeda. Karena itu
                tugas kita cukup mengubah data, bukan menyentuh DOM satu per satu.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Tiga istilah yang akan sering muncul:
            </p>
            <ul class="mt-2 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li><strong>Component</strong>: fungsi yang mengembalikan markup.</li>
                <li><strong>Props</strong>: data yang dikirim dari komponen induk ke anak. Bersifat read-only.</li>
                <li><strong>State</strong>: data milik komponen yang bisa berubah dan memicu render ulang.</li>
            </ul>
            <div class="mt-4 p-3 rounded-lg bg-primary/5 dark:bg-primary/10 border-l-4 border-primary">
                <span class="font-bold text-primary">Analogi</span>
                <p class="text-sm md:text-base text-foreground-secondary mt-1">
                    State itu angka di papan skor, tampilan itu papan skornya. Kamu tidak mengecat
                    ulang angka di papan setiap kali ada gol. Kamu cukup mengubah angkanya, dan
                    papan selalu menampilkan angka terbaru.
                </p>
            </div>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Di pertemuan ini kita memakai state seperlunya, untuk pencarian, filter, dan
                keranjang. Routing dan login belum masuk, karena keduanya dibahas di pertemuan 7.
            </p>
        </Step>

        <Step id="a4" diagram="/diagrams/06/too-much-jsx.webp">
            <StepHeader title="JSX dan TSX" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                JSX adalah ekstensi sintaks JavaScript yang membuat kita bisa menulis struktur
                antarmuka mirip HTML di dalam kode JavaScript. TSX adalah versi TypeScript-nya.
                Karena project kita memakai TypeScript, semua file komponen berekstensi
                <code class={inlineCode}>.tsx</code>.
            </p>
            <CodeBlock code={jsxExample} language="tsx" filename="MenuCard.tsx" />
            <p class="text-foreground-secondary leading-relaxed">
                JSX bukan string dan bukan HTML. Sebelum dijalankan browser, JSX dikompilasi
                menjadi pemanggilan fungsi. Kurang lebih bentuknya seperti ini:
            </p>
            <CodeBlock code={compiledJsx} language="ts" filename="hasil kompilasi (gambaran)" compact />
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Beberapa aturan yang paling sering bikin error:
            </p>
            <ul class="mt-2 text-foreground-secondary leading-relaxed space-y-1.5 list-disc list-inside">
                <li>Harus ada satu elemen pembungkus. Kalau tidak ingin menambah elemen, pakai fragment <code class={inlineCode}>&lt;&gt;...&lt;/&gt;</code>.</li>
                <li>Atribut class ditulis <code class={inlineCode}>className</code>, bukan <code class={inlineCode}>class</code>.</li>
                <li>Ekspresi JavaScript dimasukkan dengan kurung kurawal, misal <code class={inlineCode}>{'{nama}'}</code>.</li>
                <li>Label form memakai <code class={inlineCode}>htmlFor</code>, bukan <code class={inlineCode}>for</code>.</li>
                <li>Semua tag harus ditutup, termasuk yang di HTML boleh terbuka seperti <code class={inlineCode}>&lt;img /&gt;</code>.</li>
            </ul>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Karena memakai TypeScript, kita bisa menyatakan bentuk props. Ini membuat kesalahan
                seperti salah nama properti atau salah tipe ketahuan saat menulis kode, bukan saat
                aplikasi dibuka.
            </p>
            <CodeBlock code={tsxProps} language="tsx" filename="MenuCard.tsx (props bertipe)" />
            <div class="mt-4 p-4 rounded-lg bg-accent/5 dark:bg-accent/10 border-2 border-dashed border-accent">
                <span class="flex items-center gap-2 font-bold text-accent">
                    <BookOpen class="w-4 h-4" />
                    Bacaan Lanjutan
                </span>
                <ul class="text-base text-foreground-secondary mt-2 space-y-1 list-disc list-inside">
                    <li>
                        <a href="https://react.dev/learn/writing-markup-with-jsx" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Writing Markup with JSX</a>
                        : aturan JSX dan alasan di baliknya.
                    </li>
                </ul>
            </div>
        </Step>

        <Step id="a5" diagram="/diagrams/06/Props-in-react.webp">
            <StepHeader title="Props dan Reusability" tone="primary" />
            <p class="text-foreground-secondary leading-relaxed">
                Kalau kamu punya sembilan menu, bukan berarti kamu menulis sembilan komponen kartu.
                Kamu menulis satu <strong>MenuCard</strong>, lalu memakainya sembilan kali dengan
                data yang berbeda. Di sinilah props berperan.
            </p>
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                <strong>Props</strong> adalah data yang dikirim dari komponen induk ke komponen
                anak. Arahnya satu jalur, dari atas ke bawah. Anak menerima props dan memakainya
                untuk merender tampilan, tetapi tidak boleh mengubahnya.
            </p>
            <CodeBlock code={propsFlow} language="tsx" filename="Catalog.tsx dan MenuCard.tsx" />
            <p class="mt-3 text-foreground-secondary leading-relaxed">
                Perhatikan dua hal. Pertama, <code class={inlineCode}>menu</code> dikirim sebagai
                data, sehingga satu MenuCard bisa menampilkan menu apa pun. Kedua,
                <code class={inlineCode}>onSelect</code> dikirim sebagai fungsi. Anak tidak tahu
                apa yang harus terjadi saat tombol diklik, ia hanya memanggil fungsi itu. Induk yang
                memutuskan.
            </p>
            <div class="mt-4 overflow-x-auto rounded-lg border border-border">
                <table class="w-full border-collapse text-left text-sm md:text-base">
                    <thead>
                        <tr class="bg-muted text-foreground">
