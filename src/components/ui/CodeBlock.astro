---
import type { CodeLanguage } from 'astro';
import { Code } from 'astro:components';

interface Props {
  code: string;
  language: CodeLanguage;
  filename?: string;
  compact?: boolean;
  mini?: boolean;
}

const { code, language, filename, compact, mini } = Astro.props;
const sizeClass = mini ? 'p-2 text-[10px] sm:text-[11px]' : compact ? 'p-2 text-[11px] sm:text-xs' : 'p-2 text-xs sm:text-sm';
---

<div class="relative rounded-lg border border-border overflow-hidden my-4">
  {filename && (
    <div class="flex items-center justify-between px-4 py-2 bg-muted border-b border-border">
      <span class="text-sm text-foreground/80 font-mono">{filename}</span>
      <span class="text-xs text-muted-foreground uppercase">{language}</span>
    </div>
  )}

  <div class="relative">
    <Code lang={language} code={code} themes={{ light: 'github-light', dark: 'github-dark' }} class={sizeClass}/>

    <button
      class="copy-btn absolute top-2 right-2 p-2 rounded-md bg-muted hover:bg-border transition-colors cursor-pointer"
      data-code={code}
    >
      <svg class="w-4 h-4 text-muted-foreground copy-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
      </svg>
      <svg class="w-4 h-4 text-green-500 check-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </button>
  </div>
</div>

<script>
    import { initCopyButtons } from '../../lib/copyButton';
    initCopyButtons();
</script>
